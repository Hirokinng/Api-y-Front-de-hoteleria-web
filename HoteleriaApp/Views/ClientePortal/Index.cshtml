@{
    ViewData["Title"] = "Inicio";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<!-- HERO -->
<section class="relative h-[90vh] min-h-[700px] w-full flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        <div class="w-full h-full bg-gradient-to-br from-[#002547] via-[#003a6b] to-[#002547]"></div>
        <div class="absolute inset-0 opacity-20" style="background-image: url('https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=1600'); background-size: cover; background-position: center;"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-primary/40 via-transparent to-background"></div>
    </div>
    <div class="relative z-10 w-full max-w-5xl px-8 text-center">
        <h1 class="text-white text-5xl md:text-7xl font-serif mb-6 leading-tight drop-shadow-lg">
            El arte de la <br/><span class="italic">hospitalidad elevada</span>
        </h1>
        <p class="text-white/90 text-lg md:text-xl font-light mb-12 max-w-2xl mx-auto drop-shadow">
            Experimente la sofisticación en cada detalle de su estadía.
        </p>

        <!-- SEARCH BAR -->
        <form id="frmBuscar" class="glass-panel p-2 rounded-xl shadow-2xl max-w-4xl mx-auto flex flex-col md:flex-row gap-2">
            <div class="flex-1 grid grid-cols-2 md:grid-cols-4 gap-0">
                <div class="flex flex-col items-start px-4 py-3 border-r border-outline-variant/20">
                    <label class="text-[10px] uppercase tracking-widest text-slate-500 font-bold mb-1">Check-in</label>
                    <input id="fechaEntrada" type="date" class="w-full bg-transparent border-none p-0 text-sm font-medium focus:ring-0 text-on-surface"/>
                </div>
                <div class="flex flex-col items-start px-4 py-3 border-r border-outline-variant/20">
                    <label class="text-[10px] uppercase tracking-widest text-slate-500 font-bold mb-1">Check-out</label>
                    <input id="fechaSalida" type="date" class="w-full bg-transparent border-none p-0 text-sm font-medium focus:ring-0 text-on-surface"/>
                </div>
                <div class="flex flex-col items-start px-4 py-3 border-r border-outline-variant/20">
                    <label class="text-[10px] uppercase tracking-widest text-slate-500 font-bold mb-1">Huéspedes</label>
                    <select id="numHuespedes" class="w-full bg-transparent border-none p-0 text-sm font-medium focus:ring-0 text-on-surface appearance-none">
                        <option value="1">1 Persona</option>
                        <option value="2" selected>2 Personas</option>
                        <option value="3">3 Personas</option>
                        <option value="4">4 Personas</option>
                    </select>
                </div>
                <div class="flex flex-col items-start px-4 py-3">
                    <label class="text-[10px] uppercase tracking-widest text-slate-500 font-bold mb-1">Categoría</label>
                    <select id="idCategoria" class="w-full bg-transparent border-none p-0 text-sm font-medium focus:ring-0 text-on-surface appearance-none">
                        <option value="">Todas</option>
                    </select>
                </div>
            </div>
            <button type="submit" class="bg-[#2E86DE] text-white px-8 py-4 rounded-lg font-medium hover:bg-opacity-90 transition-all flex items-center justify-center gap-2 shadow-lg shadow-blue-500/20">
                <span class="material-symbols-outlined">search</span>
                Buscar
            </button>
        </form>
    </div>
</section>

<!-- DESTACADOS -->
<section class="py-24 px-8 max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
        <div class="max-w-2xl">
            <span class="text-secondary font-medium tracking-[0.2em] uppercase text-xs mb-4 block">Selección Editorial</span>
            <h2 class="text-4xl md:text-5xl font-serif text-primary leading-tight">Destacados</h2>
        </div>
        <a asp-controller="ClientePortal" asp-action="Buscar"
           class="text-primary font-medium flex items-center gap-2 hover:gap-4 transition-all pb-2 border-b border-primary/10 no-underline">
            Ver todas las habitaciones
            <span class="material-symbols-outlined">arrow_forward</span>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8" id="destacadosGrid">
        <div class="col-span-3 text-center py-12 text-secondary">
            <span class="material-symbols-outlined animate-pulse">hotel</span> Cargando categorías...
        </div>
    </div>
</section>

<!-- EXPERIENCIAS -->
<section class="bg-surface-container-low py-24">
    <div class="max-w-7xl mx-auto px-8">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 h-auto md:h-[500px]">
            <div class="md:col-span-8 relative rounded-2xl overflow-hidden group bg-primary flex items-end p-12">
                <div class="relative z-10">
                    <h3 class="text-white text-4xl font-serif mb-4">Relajación y Confort</h3>
                    <p class="text-white/80 max-w-md">Nuestras categorías de habitación están diseñadas para ofrecerte la mejor experiencia.</p>
                </div>
            </div>
            <div class="md:col-span-4 grid grid-rows-2 gap-6">
                <div class="relative rounded-2xl overflow-hidden bg-[#003a6b] flex items-end p-6">
                    <span class="text-white font-serif text-xl">Servicios Premium</span>
                </div>
                <div class="relative rounded-2xl overflow-hidden bg-[#002547] flex items-end p-6">
                    <span class="text-white font-serif text-xl">Atención Personalizada</span>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
(async function() {
    try {
        const res = await fetch('/api/Category');
        if (!res.ok) return;
        const cats = await res.json();

        // Fill categoria dropdown
        const sel = document.getElementById('idCategoria');
        cats.forEach(c => {
            sel.innerHTML += `<option value="${c.id}">${c.name}</option>`;
        });

        // Fill destacados
        const grid = document.getElementById('destacadosGrid');
        grid.innerHTML = '';
        const items = cats.filter(c => c.isActive).slice(0, 3);
        if (items.length === 0) {
            grid.innerHTML = '<div class="col-span-3 text-center text-secondary py-8">No hay categorías disponibles.</div>';
            return;
        }
        items.forEach(c => {
            grid.innerHTML += `
            <div class="group bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 flex flex-col">
                <div class="relative h-72 bg-gradient-to-br from-[#002547] to-[#2E86DE] flex items-center justify-center">
                    <span class="material-symbols-outlined text-white/30 text-8xl">hotel</span>
                    <div class="absolute top-4 left-4">
                        <span class="bg-primary text-white text-[10px] px-3 py-1 rounded-full uppercase tracking-widest font-bold">${c.name}</span>
                    </div>
                </div>
                <div class="p-8 flex flex-col flex-grow">
                    <div class="flex justify-between items-start mb-4">
                        <h3 class="text-2xl font-serif text-primary">${c.name}</h3>
                        <div class="text-right">
                            <span class="block text-xs text-slate-400 font-bold uppercase tracking-tighter">Desde</span>
                            <span class="text-xl font-medium text-primary">RD$${Number(c.pricePerNight).toLocaleString()}</span>
                        </div>
                    </div>
                    <p class="text-slate-500 text-sm leading-relaxed mb-8 flex-grow">${c.description || 'Habitación disponible en nuestro hotel.'}</p>
                    <div class="flex items-center gap-4 pt-6 border-t border-outline-variant/10">
                        <span class="text-xs text-secondary">${c.characteristics || ''}</span>
                    </div>
                </div>
            </div>`;
        });
    } catch(e) {
        console.error(e);
    }
})();

document.getElementById('frmBuscar').addEventListener('submit', function(e) {
    e.preventDefault();
    const fechaEntrada = document.getElementById('fechaEntrada').value;
    const fechaSalida = document.getElementById('fechaSalida').value;
    const numHuespedes = document.getElementById('numHuespedes').value;
    const idCategoria = document.getElementById('idCategoria').value;
    if (!fechaEntrada || !fechaSalida) {
        alert('Por favor selecciona las fechas de entrada y salida.');
        return;
    }
    window.location.href = `/ClientePortal/Buscar?fechaEntrada=${fechaEntrada}&fechaSalida=${fechaSalida}&numHuespedes=${numHuespedes}&idCategoria=${idCategoria}`;
});
</script>
}
