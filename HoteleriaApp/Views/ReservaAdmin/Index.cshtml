@{
    ViewData["Title"] = "Gestión de Reservas";
}

<div class="pb-12 px-8 max-w-[1600px] mx-auto space-y-8 pt-8">

    <div>
        <p class="text-xs font-bold text-secondary tracking-widest uppercase mb-2">GESTIÓN DE RESERVAS</p>
        <h1 class="font-headline text-4xl text-primary">Gestión de Reservas</h1>
        <p class="text-secondary text-sm mt-1">Vista general del flujo operativo de huéspedes para el ciclo actual.</p>
    </div>

    
    <div class="grid grid-cols-4 gap-0 bg-white rounded-xl border border-outline-variant/20 shadow-sm overflow-hidden">
        <div class="p-8 border-r border-outline-variant/20">
            <p class="text-xs font-bold text-secondary tracking-widest uppercase mb-2">Total Reservas</p>
            <p class="font-headline text-4xl font-bold text-primary" id="statTotal">—</p>
        </div>
        <div class="p-8 border-r border-l-4 border-l-[#2E86DE] border-r-outline-variant/20">
            <p class="text-xs font-bold tracking-widest uppercase mb-2 text-[#2E86DE]">Pendientes</p>
            <p class="font-headline text-4xl font-bold text-[#2E86DE]" id="statPendientes">—</p>
        </div>
        <div class="p-8 border-r border-outline-variant/20">
            <p class="text-xs font-bold tracking-widest uppercase mb-2 text-emerald-600">Confirmadas</p>
            <p class="font-headline text-4xl font-bold text-emerald-600" id="statConfirmadas">—</p>
        </div>
        <div class="p-8 border-l-4 border-l-red-400">
            <p class="text-xs font-bold tracking-widest uppercase mb-2 text-red-500">Canceladas</p>
            <p class="font-headline text-4xl font-bold text-red-500" id="statCanceladas">—</p>
        </div>
    </div>

   
    <div class="bg-white rounded-xl border border-outline-variant/20 shadow-sm overflow-hidden">
        <table class="w-full">
            <thead>
                <tr class="bg-[#002547] text-white">
                    <th class="text-left px-6 py-4 text-xs font-bold tracking-widest uppercase opacity-70">N° Reserva</th>
                    <th class="text-left px-6 py-4 text-xs font-bold tracking-widest uppercase opacity-70">Cliente</th>
                    <th class="text-left px-6 py-4 text-xs font-bold tracking-widest uppercase opacity-70">Fecha Entrada</th>
                    <th class="text-left px-6 py-4 text-xs font-bold tracking-widest uppercase opacity-70">Fecha Salida</th>
                    <th class="text-left px-6 py-4 text-xs font-bold tracking-widest uppercase opacity-70">Huéspedes</th>
                    <th class="text-left px-6 py-4 text-xs font-bold tracking-widest uppercase opacity-70">Estado</th>
                    <th class="text-left px-6 py-4 text-xs font-bold tracking-widest uppercase opacity-70 w-24">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/10" id="tablaReservas">
                <tr>
                    <td colspan="7" class="px-6 py-12 text-center text-secondary text-sm">
                        <span class="material-symbols-outlined text-3xl block mb-2 animate-spin">sync</span>
                        Cargando reservas...
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="px-6 py-4 border-t border-outline-variant/10">
            <span class="text-xs text-secondary" id="conteoReservas"></span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-[#002547] rounded-xl p-8 text-white">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-lg bg-[#59a6ff]/10 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[#59a6ff]">bar_chart</span>
                </div>
                <div>
                    <p class="text-[10px] font-bold tracking-widest uppercase text-[#59a6ff]">Métricas Globales · Ciclo Actual</p>
                </div>
            </div>
            <div class="flex gap-12">
                <div>
                    <p class="text-xs text-white/50 uppercase tracking-widest mb-1">Total Noches</p>
                    <p class="font-headline text-4xl font-bold text-white" id="totalNoches">—</p>
                </div>
                <div>
                    <p class="text-xs text-white/50 uppercase tracking-widest mb-1">Promedio Estancia</p>
                    <p class="font-headline text-4xl font-bold text-[#2E86DE]" id="promedioNoches">—</p>
                    <p class="text-xs text-white/40 mt-1">NOCHES</p>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-xl border border-outline-variant/20 shadow-sm p-8 flex items-center justify-between">
            <div>
                <p class="text-xs font-bold text-secondary tracking-widest uppercase mb-2">Exportar Reporte</p>
                <p class="text-sm text-on-surface-variant">Descarga el reporte completo de reservas del ciclo actual.</p>
            </div>
            <button class="px-6 py-3 bg-[#002547] hover:bg-[#003a6b] text-white rounded-lg font-medium transition-all flex items-center gap-2 text-sm">
                <span class="material-symbols-outlined text-sm">download</span>
                Exportar
            </button>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        (async function () {
            try {
                const res = await fetch('/api/ReservaApi');
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const reservas = await res.json();

                const pendientes   = reservas.filter(r => r.estado === 0).length;
                const confirmadas  = reservas.filter(r => r.estado === 1).length;
                const canceladas   = reservas.filter(r => r.estado === 2).length;
                const completadas  = reservas.filter(r => r.estado === 3).length;

                document.getElementById('statTotal').textContent       = reservas.length;
                document.getElementById('statPendientes').textContent  = pendientes;
                document.getElementById('statConfirmadas').textContent = confirmadas;
                document.getElementById('statCanceladas').textContent  = canceladas;
                document.getElementById('conteoReservas').textContent  = `Mostrando ${reservas.length} reserva(s)`;

        
                const totalNoches = reservas.reduce((acc, r) => {
                    if (!r.fechaEntrada || !r.fechaSalida) return acc;
                    const diff = new Date(r.fechaSalida) - new Date(r.fechaEntrada);
                    return acc + Math.round(diff / (1000 * 60 * 60 * 24));
                }, 0);
                const promedio = reservas.length > 0 ? (totalNoches / reservas.length).toFixed(1) : '0';
                document.getElementById('totalNoches').textContent  = totalNoches;
                document.getElementById('promedioNoches').textContent = promedio;

                const estadoConfig = {
                    0: { label: 'PENDIENTE',   cls: 'bg-blue-50 text-[#2E86DE]' },
                    1: { label: 'CONFIRMADA',  cls: 'bg-emerald-50 text-emerald-700' },
                    2: { label: 'CANCELADA',   cls: 'bg-red-50 text-red-600' },
                    3: { label: 'COMPLETADA',  cls: 'bg-surface-container-low text-secondary' }
                };

                const tbody = document.getElementById('tablaReservas');

                if (reservas.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="7" class="px-6 py-16 text-center">
                                <div class="w-16 h-16 rounded-full bg-surface-container-low flex items-center justify-center mb-4 mx-auto">
                                    <span class="material-symbols-outlined text-3xl text-secondary">calendar_month</span>
                                </div>
                                <h3 class="font-headline text-2xl text-primary mb-2">Sin reservas registradas</h3>
                                <p class="text-secondary text-sm max-w-xs mx-auto">No hay reservas en el sistema todavía.</p>
                            </td>
                        </tr>`;
                    return;
                }

                tbody.innerHTML = reservas.map(r => {
                    const est = estadoConfig[r.estado] ?? estadoConfig[0];
                    const iniciales = (r.cliente?.nombre || r.nombreCliente || '??')
                        .split(' ').slice(0, 2).map(n => n[0]).join('').toUpperCase();
                    const colores = ['bg-[#2E86DE]', 'bg-[#002547]', 'bg-secondary', 'bg-emerald-600', 'bg-amber-500'];
                    const color = colores[iniciales.charCodeAt(0) % colores.length];

                    const fechaEntrada = r.fechaEntrada ? new Date(r.fechaEntrada).toLocaleDateString('es-DO', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
                    const fechaSalida  = r.fechaSalida  ? new Date(r.fechaSalida).toLocaleDateString('es-DO',  { day: 'numeric', month: 'short', year: 'numeric' }) : '—';

                    let menuOpciones = `
                        <a href="/Reserva/Detalle/${r.id}"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-on-surface hover:bg-surface-container-low transition-colors w-full">
                            <span class="material-symbols-outlined text-sm text-secondary">visibility</span>
                            Ver Detalle
                        </a>`;

                    if (r.estado === 0) {
                        menuOpciones += `
                        <button onclick="cambiarEstado('${r.id}', 1, this)"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-on-surface hover:bg-surface-container-low transition-colors w-full text-left">
                            <span class="material-symbols-outlined text-sm text-emerald-600">check_circle</span>
                            Confirmar
                        </button>`;
                    }
                    if (r.estado !== 2 && r.estado !== 3) {
                        menuOpciones += `
                        <button onclick="cambiarEstado('${r.id}', 2, this)"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors w-full text-left">
                            <span class="material-symbols-outlined text-sm">cancel</span>
                            Cancelar
                        </button>`;
                    }

                    return `
                        <tr class="hover:bg-surface-container-low transition-colors">
                            <td class="px-6 py-5">
                                <span class="font-bold text-primary text-sm">#GP-${r.numeroReserva || r.id?.toString().slice(-4).toUpperCase()}</span>
                            </td>
                            <td class="px-6 py-5">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full ${color} flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                                        ${iniciales}
                                    </div>
                                    <span class="text-sm font-medium text-on-surface">${r.cliente?.nombre || r.nombreCliente || '—'}</span>
                                </div>
                            </td>
                            <td class="px-6 py-5 text-secondary text-sm">${fechaEntrada}</td>
                            <td class="px-6 py-5 text-secondary text-sm">${fechaSalida}</td>
                            <td class="px-6 py-5 text-secondary text-sm">${r.numeroHuespedes || '—'}</td>
                            <td class="px-6 py-5">
                                <span class="inline-block text-[10px] font-bold px-3 py-1 rounded-full tracking-wide ${est.cls}">
                                    ${est.label}
                                </span>
                            </td>
                            <td class="px-6 py-5 relative">
                                <button onclick="toggleMenu('menu-${r.id}', event)"
                                        class="p-2 text-secondary hover:text-[#2E86DE] hover:bg-surface-container-low rounded-lg transition-all">
                                    <span class="material-symbols-outlined text-sm">more_vert</span>
                                </button>
                                <div id="menu-${r.id}"
                                     class="hidden absolute right-6 top-12 z-50 bg-white rounded-xl shadow-lg border border-outline-variant/20 min-w-[180px] overflow-hidden">
                                    ${menuOpciones}
                                </div>
                            </td>
                        </tr>`;
                }).join('');

            } catch (e) {
                document.getElementById('tablaReservas').innerHTML = `
                    <tr><td colspan="7" class="px-6 py-8 text-center text-red-500 text-sm">Error al cargar reservas: ${e.message}</td></tr>`;
            }
        })();

        function toggleMenu(id, event) {
            event.stopPropagation();
            document.querySelectorAll('[id^="menu-"]').forEach(m => {
                if (m.id !== id) m.classList.add('hidden');
            });
            document.getElementById(id).classList.toggle('hidden');
        }

        document.addEventListener('click', function () {
            document.querySelectorAll('[id^="menu-"]').forEach(m => m.classList.add('hidden'));
        });

        async function cambiarEstado(id, nuevoEstado, btn) {
            btn.disabled = true;
            try {
                const dto = nuevoEstado === 2
                    ? await fetch(`/api/ReservaApi/${id}`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${getToken()}` } })
                    : await fetch(`/api/ReservaApi/${id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${getToken()}` },
                        body: JSON.stringify({ estado: nuevoEstado })
                    });
                if (dto.ok) location.reload();
                else alert('Error al cambiar estado.');
            } catch (e) {
                alert('Error: ' + e.message);
            } finally {
                btn.disabled = false;
            }
        }

        function getToken() {
            return document.cookie.split(';').find(c => c.trim().startsWith('JwtToken='))?.split('=')[1] || '';
        }
    </script>
}
