@{
    ViewData["Title"] = "Detalle de Reserva";
}

<div id="contenidoReserva" class="pb-12">

    <div class="bg-white/80 backdrop-blur-xl sticky top-[73px] z-30 px-8 py-5 flex items-center justify-between border-b border-outline-variant/10">
        <div class="flex items-center gap-4">
            <a asp-action="Index"
               class="p-2 hover:bg-surface-container-high rounded-full transition-all text-primary no-underline">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div>
                <p class="text-xs font-bold text-secondary tracking-widest uppercase">Gestión de Reservas</p>
                <h1 class="font-headline text-3xl font-semibold text-primary" id="tituloReserva">Cargando...</h1>
            </div>
        </div>
        <div class="flex items-center gap-3" id="botonesAccion">
           
        </div>
    </div>

    <div class="max-w-[1400px] mx-auto px-8 py-10">
        <div class="grid grid-cols-12 gap-8">

            <div class="col-span-12 lg:col-span-7 space-y-8">

                <section class="bg-white rounded-xl p-10 shadow-sm border border-outline-variant/20 relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-[#002547]/5 rounded-bl-full pointer-events-none"></div>

                    <div class="flex justify-between items-start mb-10">
                        <div>
                            <h2 class="font-headline text-4xl font-medium text-primary mb-1" id="nombreCliente">—</h2>
                            <p class="text-secondary text-sm flex items-center gap-2" id="emailCliente">
                                <span class="material-symbols-outlined text-sm">mail</span>
                                <span>—</span>
                            </p>
                        </div>
                        <span id="badgeEstado" class="px-4 py-1.5 rounded-full text-sm font-semibold tracking-wide flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full animate-pulse"></span>
                            —
                        </span>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-3 gap-8">
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.2em] text-outline font-bold mb-1">Fechas</p>
                            <p class="text-lg font-medium text-primary" id="fechas">—</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.2em] text-outline font-bold mb-1">Huéspedes</p>
                            <p class="text-lg font-medium text-primary" id="huespedes">—</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.2em] text-outline font-bold mb-1">Noches</p>
                            <p class="text-lg font-medium text-primary" id="noches">—</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.2em] text-outline font-bold mb-1">Check-in</p>
                            <p class="text-lg font-medium text-primary">15:00 PM</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.2em] text-outline font-bold mb-1">Check-out</p>
                            <p class="text-lg font-medium text-primary">11:00 AM</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.2em] text-outline font-bold mb-1">Origen</p>
                            <p class="text-lg font-medium text-primary italic">Direct Booking</p>
                        </div>
                    </div>

                    <div class="mt-10 pt-8 border-t border-outline-variant/20 flex justify-between items-end">
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.2em] text-outline font-bold mb-2">Total Estancia</p>
                            <p class="font-headline text-5xl font-bold text-primary" id="totalEstancia">—</p>
                        </div>
                    </div>
                </section>

                <section class="space-y-4">
                    <h3 class="font-headline text-2xl font-semibold text-primary">Historial de la Reserva</h3>
                    <div class="bg-white rounded-xl border border-outline-variant/20 shadow-sm p-8 space-y-8" id="timeline">
                        <div class="flex items-center gap-3 text-secondary text-sm">
                            <span class="material-symbols-outlined animate-spin">sync</span>
                            Cargando historial...
                        </div>
                    </div>
                </section>

            </div>

   
            <div class="col-span-12 lg:col-span-5 space-y-6">

   
                <section>
                    <h3 class="font-headline text-2xl font-semibold text-primary mb-4">Habitación Asignada</h3>
                    <div id="habitacionesAsignadas">
                        <div class="bg-white rounded-xl border border-outline-variant/20 shadow-sm p-8 text-center text-secondary text-sm">
                            <span class="material-symbols-outlined text-3xl block mb-2 text-secondary/40">bed</span>
                            Sin habitación asignada aún.
                        </div>
                    </div>
                </section>

                <section class="bg-[#002547] text-white rounded-xl p-8 relative overflow-hidden">
                    <div class="absolute -bottom-10 -right-10 w-40 h-40 bg-white/5 rounded-full blur-2xl pointer-events-none"></div>
                    <h3 class="font-headline text-2xl italic mb-3 relative z-10">Notas del Concierge</h3>
                    <p class="text-[#59a6ff] leading-relaxed text-sm font-light relative z-10">
                        Verifique las solicitudes especiales del huésped antes del check-in. Confirme amenities y preferencias registradas en el perfil del cliente.
                    </p>
                    <div class="flex items-center gap-3 mt-6 opacity-70 relative z-10">
                        <div class="w-8 h-8 rounded-full bg-[#59a6ff]/10 flex items-center justify-center">
                            <span class="material-symbols-outlined text-sm text-[#59a6ff]">record_voice_over</span>
                        </div>
                        <span class="text-xs font-medium tracking-wide">Recepción Principal</span>
                    </div>
                </section>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const id = window.location.pathname.split('/').pop();
        const token = sessionStorage.getItem('JwtToken') || '';

        const estadoConfig = {
            0: { label: 'Pendiente',  cls: 'bg-blue-50 text-[#2E86DE]',      dot: 'bg-[#2E86DE]' },
            1: { label: 'Confirmada', cls: 'bg-emerald-50 text-emerald-700',  dot: 'bg-emerald-500' },
            2: { label: 'Cancelada',  cls: 'bg-red-50 text-red-600',          dot: 'bg-red-500' },
            3: { label: 'Completada', cls: 'bg-surface-container-low text-secondary', dot: 'bg-secondary' }
        };

        (async function () {
            try {
                const res = await fetch(`/api/ReservaApi/${id}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const r = await res.json();

                document.getElementById('tituloReserva').textContent =
                    `Reserva #${r.numeroReserva || id.slice(-6).toUpperCase()}`;

                document.getElementById('nombreCliente').textContent =
                    r.cliente?.nombre || r.nombreCliente || '—';
                document.getElementById('emailCliente').querySelector('span:last-child').textContent =
                    r.cliente?.email || r.emailCliente || '—';

                const est = estadoConfig[r.estado] ?? estadoConfig[0];
                const badge = document.getElementById('badgeEstado');
                badge.className = `px-4 py-1.5 rounded-full text-sm font-semibold tracking-wide flex items-center gap-2 ${est.cls}`;
                badge.querySelector('span').className = `w-2 h-2 rounded-full animate-pulse ${est.dot}`;
                badge.childNodes[badge.childNodes.length - 1].textContent = est.label;

       
                const fe = r.fechaEntrada ? new Date(r.fechaEntrada) : null;
                const fs = r.fechaSalida  ? new Date(r.fechaSalida)  : null;
                const opts = { day: 'numeric', month: 'short', year: 'numeric' };
                document.getElementById('fechas').textContent =
                    fe && fs ? `${fe.toLocaleDateString('es-DO', opts)} - ${fs.toLocaleDateString('es-DO', opts)}` : '—';

                const noches = fe && fs ? Math.round((fs - fe) / (1000 * 60 * 60 * 24)) : 0;
                document.getElementById('huespedes').textContent  = `${r.numeroHuespedes || '—'} Huéspedes`;
                document.getElementById('noches').textContent     = `${noches} Noches`;
                document.getElementById('totalEstancia').textContent =
                    r.total ? `RD$${Number(r.total).toLocaleString('es-DO')}` : '—';

     
                const btns = document.getElementById('botonesAccion');
                if (r.estado === 0) {
                    btns.innerHTML = `
                        <button onclick="confirmar('${r.id}')"
                                class="px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-medium transition-colors flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm">check_circle</span> Confirmar
                        </button>
                        <button onclick="cancelar('${r.id}')"
                                class="px-6 py-2.5 rounded-xl border border-red-400 text-red-500 font-medium hover:bg-red-50 transition-colors">
                            Cancelar
                        </button>`;
                } else if (r.estado === 1) {
                    btns.innerHTML = `
                        <button onclick="completar('${r.id}')"
                                class="px-6 py-2.5 rounded-xl bg-surface-container-highest text-secondary font-medium hover:bg-surface-variant transition-colors">
                            Completar
                        </button>
                        <button onclick="cancelar('${r.id}')"
                                class="px-6 py-2.5 rounded-xl border border-red-400 text-red-500 font-medium hover:bg-red-50 transition-colors">
                            Cancelar
                        </button>`;
                }

                const habs = r.habitaciones || [];
                const habContainer = document.getElementById('habitacionesAsignadas');
                if (habs.length > 0) {
                    habContainer.innerHTML = habs.map(rh => `
                        <div class="bg-white rounded-xl border border-outline-variant/20 shadow-sm p-6">
                            <div class="flex items-center justify-between mb-4">
                                <span class="text-xs font-bold bg-surface-container-low text-secondary px-3 py-1 rounded-full tracking-widest uppercase">
                                    Habitación ${rh.habitacion?.numero || '—'}
                                </span>
                                ${rh.esPrincipal ? '<span class="text-xs text-[#2E86DE] font-bold">Principal</span>' : ''}
                            </div>
                            <h4 class="font-headline text-xl text-primary mb-3">${rh.habitacion?.tipoHabitacion?.nombre || '—'}</h4>
                            <div class="flex items-center gap-6 text-secondary text-sm">
                                <span class="flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">layers</span>
                                    Piso ${rh.habitacion?.piso || '—'}
                                </span>
                                <span class="flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">group</span>
                                    Cap. ${rh.habitacion?.capacidad || '—'}
                                </span>
                            </div>
                        </div>`).join('');
                }

      
                const historiales = r.historiales || [];
                const timeline = document.getElementById('timeline');
                if (historiales.length > 0) {
                    timeline.innerHTML = historiales.map((h, i) => `
                        <div class="relative flex gap-6">
                            <div class="flex flex-col items-center">
                                <div class="z-10 bg-[#002547] text-white p-1 rounded-full">
                                    <span class="material-symbols-outlined text-sm">
                                        ${i === 0 ? 'check' : 'history'}
                                    </span>
                                </div>
                                ${i < historiales.length - 1 ? '<div class="w-0.5 flex-1 bg-outline-variant/20 mt-1"></div>' : ''}
                            </div>
                            <div class="pb-6">
                                <p class="font-bold text-primary">${h.descripcion || 'Cambio de estado'}</p>
                                <p class="text-sm text-secondary mt-1">
                                    ${h.fecha ? new Date(h.fecha).toLocaleDateString('es-DO', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—'}
                                </p>
                            </div>
                        </div>`).join('');
                } else {
                    timeline.innerHTML = `
                        <div class="relative flex gap-6">
                            <div class="z-10 bg-[#002547] text-white p-1 rounded-full h-fit">
                                <span class="material-symbols-outlined text-sm">edit_note</span>
                            </div>
                            <div>
                                <p class="font-bold text-primary">Reserva creada</p>
                                <p class="text-sm text-secondary mt-1">${fe ? fe.toLocaleDateString('es-DO') : '—'} · Sistema</p>
                            </div>
                        </div>`;
                }

            } catch (e) {
                document.getElementById('tituloReserva').textContent = 'Error al cargar';
                console.error(e);
            }
        })();

        async function confirmar(id) {
            if (!confirm('¿Confirmar esta reserva?')) return;
            await fetch(`/api/ReservaApi/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                body: JSON.stringify({ estado: 1 })
            });
            location.reload();
        }

        async function cancelar(id) {
            if (!confirm('¿Cancelar esta reserva? Esta acción no se puede deshacer.')) return;
            await fetch(`/api/ReservaApi/${id}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${token}` }
            });
            location.href = '/Reserva/Index';
        }

        async function completar(id) {
            if (!confirm('¿Marcar esta reserva como completada?')) return;
            await fetch(`/api/ReservaApi/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                body: JSON.stringify({ estado: 3 })
            });
            location.reload();
        }
    </script>
}
