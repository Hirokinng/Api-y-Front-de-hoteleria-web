@{
    ViewData["Title"] = "Acceso Administrador";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>HOTELERIA - Acceso Administrador</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Newsreader:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#002547", "secondary": "#455f87",
                        "surface": "#f6f9fe", "surface-container-highest": "#dfe3e8",
                        "surface-container-lowest": "#ffffff", "surface-container": "#ebeef3",
                        "on-surface": "#181c20", "on-surface-variant": "#43474e",
                        "outline": "#74777f", "outline-variant": "#c4c6cf",
                        "on-primary-container": "#59a6ff", "primary-fixed": "#d3e4ff",
                        "brand-blue": "#2E86DE"
                    },
                    fontFamily: {
                        "headline": ["Newsreader", "serif"],
                        "body": ["Inter", "sans-serif"]
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
    </style>
</head>
<body class="bg-[#002547] font-body text-on-surface min-h-screen flex">

    <div class="hidden lg:flex lg:w-1/2 flex-col justify-between p-16 relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-[#002547] to-[#003a6b]"></div>
        <div class="absolute bottom-0 right-0 w-96 h-96 bg-[#2E86DE]/10 rounded-full -mr-48 -mb-48 blur-3xl"></div>
        <div class="absolute top-0 left-0 w-64 h-64 bg-[#59a6ff]/5 rounded-full -ml-32 -mt-32 blur-3xl"></div>

        <div class="relative z-10">
            <h1 class="font-headline italic text-4xl text-white tracking-tight">HOTELERIA</h1>
            <p class="text-[#59a6ff] text-xs tracking-[0.3em] uppercase mt-1 font-medium">Digital Concierge</p>
        </div>

        <div class="relative z-10 space-y-8">
            <div>
                <h2 class="font-headline text-5xl text-white leading-tight mb-4">
                    Panel de<br/>Administración
                </h2>
                <p class="text-white/50 text-sm leading-relaxed max-w-sm">
                    Gestiona habitaciones, reservas, categorías y pisos del hotel desde un solo lugar.
                </p>
            </div>

            <div class="space-y-4">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-[#59a6ff]/10 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[#59a6ff] text-sm">bed</span>
                    </div>
                    <span class="text-white/60 text-sm">Gestión de Habitaciones</span>
                </div>
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-[#59a6ff]/10 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[#59a6ff] text-sm">calendar_month</span>
                    </div>
                    <span class="text-white/60 text-sm">Control de Reservas</span>
                </div>
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-[#59a6ff]/10 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[#59a6ff] text-sm">category</span>
                    </div>
                    <span class="text-white/60 text-sm">Categorías y Tarifas</span>
                </div>
            </div>
        </div>

        <div class="relative z-10">
            <p class="text-white/20 text-xs">&copy; @DateTime.Now.Year HOTELERIA. Todos los derechos reservados.</p>
        </div>
    </div>

    <div class="flex-1 bg-surface flex items-center justify-center p-8">
        <div class="w-full max-w-[400px]">

            <div class="lg:hidden text-center mb-10">
                <h1 class="font-headline italic text-3xl text-primary">HOTELERIA</h1>
                <p class="text-secondary text-xs tracking-widest uppercase mt-1">Digital Concierge</p>
            </div>

            <div class="mb-8">
                <div class="w-12 h-12 rounded-xl bg-[#002547] flex items-center justify-center mb-4">
                    <span class="material-symbols-outlined text-white">admin_panel_settings</span>
                </div>
                <h2 class="font-headline text-3xl text-primary mb-1">Acceso Admin</h2>
                <p class="text-secondary text-sm">Ingresa con tus credenciales de administrador.</p>
            </div>

            <form asp-controller="AdminAuth" asp-action="Login" method="post" class="space-y-5">
                @Html.AntiForgeryToken()

                <div class="space-y-2">
                    <label class="block text-[11px] font-semibold text-secondary uppercase tracking-wider">
                        Correo Electrónico
                    </label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline text-lg">mail</span>
                        <input name="Email" type="email" placeholder="admin@hotel.com" required
                               class="w-full pl-12 pr-4 py-3.5 bg-surface-container-highest/50 border-none rounded-lg text-on-surface placeholder:text-outline/60 focus:ring-1 focus:ring-primary/20 transition-all outline-none text-sm"/>
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="block text-[11px] font-semibold text-secondary uppercase tracking-wider">
                        Contraseña
                    </label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline text-lg">lock</span>
                        <input name="Password" type="password" placeholder="••••••••" required
                               class="w-full pl-12 pr-4 py-3.5 bg-surface-container-highest/50 border-none rounded-lg text-on-surface placeholder:text-outline/60 focus:ring-1 focus:ring-primary/20 transition-all outline-none text-sm"/>
                    </div>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="flex items-center gap-3 p-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">
                        <span class="material-symbols-outlined text-sm flex-shrink-0" style="font-variation-settings:'FILL' 1;">error</span>
                        @ViewBag.Error
                    </div>
                }

                <button type="submit"
                        class="w-full bg-[#2E86DE] hover:bg-[#2575c0] text-white font-medium py-4 rounded-lg shadow-lg shadow-blue-500/20 active:scale-[0.98] transition-all text-sm tracking-wide mt-2">
                    Iniciar Sesión
                </button>
            </form>

            <div class="mt-8 pt-6 border-t border-outline-variant/20 text-center">
                <a asp-controller="ClientesMvc" asp-action="Login"
                   class="text-sm text-secondary hover:text-primary transition-colors no-underline">
                    ¿Eres cliente? <span class="text-[#2E86DE] font-semibold">Accede aquí</span>
                </a>
            </div>
        </div>
    </div>

</body>
</html>
