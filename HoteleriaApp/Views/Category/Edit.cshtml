@model HoteleriaApp.Core.Application.DTOs.Category.UpdateCategoryDto

@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="max-w-6xl mx-auto px-8 py-10">

    <header class="mb-10">
        <div class="flex items-center gap-3 mb-4">
            <a asp-action="Index" class="p-2 text-secondary hover:text-primary hover:bg-surface-container-low rounded-lg transition-all">
                <span class="material-symbols-outlined text-sm">arrow_back</span>
            </a>
            <span class="text-secondary text-sm">Categorías</span>
            <span class="material-symbols-outlined text-sm text-outline">chevron_right</span>
            <span class="text-primary text-sm font-medium">Editar Categoría</span>
        </div>
        <div class="flex items-center justify-between">
            <div>
                <h1 class="font-headline text-5xl text-primary font-bold mb-4 tracking-tight">Editar Categoría</h1>
                <p class="text-secondary text-lg max-w-2xl">Modifica los datos de esta categoría. Los cambios no afectarán reservas existentes.</p>
            </div>
            @if (Model.IsActive)
            {
                <span class="inline-flex items-center gap-2 bg-green-100 text-green-700 text-xs font-bold px-3 py-2 rounded-full uppercase tracking-wide">
                    <span class="w-2 h-2 rounded-full bg-green-500"></span> Activa
                </span>
            }
            else
            {
                <span class="inline-flex items-center gap-2 bg-red-100 text-red-700 text-xs font-bold px-3 py-2 rounded-full uppercase tracking-wide">
                    <span class="w-2 h-2 rounded-full bg-red-500"></span> Inactiva
                </span>
            }
        </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 overflow-hidden rounded-xl shadow-sm border border-outline-variant/10">

        <section class="lg:col-span-8 bg-white p-8 md:p-12">
            <form asp-action="Edit" method="post" class="space-y-8">
                <input asp-for="Id" type="hidden" />

                <div class="space-y-6">
                    <div>
                        <label class="block text-xs font-bold text-primary tracking-widest uppercase mb-2">Nombre de la Categoría *</label>
                        <input asp-for="Name" type="text"
                               class="w-full bg-surface-container-highest border-none rounded-lg p-4 focus:ring-2 focus:ring-primary/20 focus:bg-white transition-all text-on-surface"
                               placeholder="Nombre de la categoría" />
                        <span asp-validation-for="Name" class="text-red-500 text-xs mt-1"></span>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-primary tracking-widest uppercase mb-2">Descripción</label>
                        <textarea asp-for="Description" rows="4"
                                  class="w-full bg-surface-container-highest border-none rounded-lg p-4 focus:ring-2 focus:ring-primary/20 focus:bg-white transition-all text-on-surface"
                                  placeholder="Descripción de la categoría..."></textarea>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-primary tracking-widest uppercase mb-2">Precio por Noche (RD$) *</label>
                        <div class="relative">
                            <span class="absolute left-4 top-4 text-secondary font-medium">RD$</span>
                            <input asp-for="PricePerNight" type="number" step="0.01" min="0"
                                   class="w-full bg-surface-container-highest border-none rounded-lg p-4 pl-12 focus:ring-2 focus:ring-primary/20 focus:bg-white transition-all text-on-surface font-medium" />
                        </div>
                        <span asp-validation-for="PricePerNight" class="text-red-500 text-xs mt-1"></span>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-primary tracking-widest uppercase mb-2">Estado</label>
                        <label class="flex items-center gap-3 p-4 rounded-lg bg-surface-container-highest cursor-pointer hover:bg-surface-container-high transition-colors">
                            <input asp-for="IsActive" type="checkbox"
                                   class="rounded text-[#2E86DE] focus:ring-[#2E86DE] w-4 h-4" />
                            <span class="text-sm font-medium text-secondary">Categoría activa</span>
                        </label>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-primary tracking-widest uppercase mb-2">Características</label>
                    <input asp-for="Characteristics" type="text"
                           class="w-full bg-surface-container-highest border-none rounded-lg p-4 focus:ring-2 focus:ring-primary/20 focus:bg-white transition-all text-on-surface"
                           placeholder="WiFi, TV, Jacuzzi, Minibar..." />
                    <p class="text-xs text-secondary mt-2">Separa las características con comas.</p>
                </div>

                <div class="flex items-center justify-between pt-8 border-t border-outline-variant/10">
                    <div class="text-xs text-secondary">
                        ID de categoría: <span class="font-bold text-primary">#@Model.Id</span>
                    </div>
                    <div class="flex gap-4">
                        <a asp-action="Index"
                           class="px-8 py-3 rounded-lg border-2 border-outline-variant text-secondary font-bold hover:bg-surface-container-low transition-all no-underline">
                            Cancelar
                        </a>
                        <button type="submit"
                                class="px-10 py-3 rounded-lg bg-[#2E86DE] text-white font-bold shadow-lg shadow-blue-500/20 hover:bg-[#2575c0] hover:scale-[1.02] active:scale-[0.98] transition-all">
                            Guardar Cambios
                        </button>
                    </div>
                </div>
            </form>
        </section>

        <aside class="lg:col-span-4 bg-[#002547] p-8 md:p-12 flex flex-col relative overflow-hidden">
            <div class="absolute inset-0 opacity-20 pointer-events-none bg-[radial-gradient(circle_at_top_right,_#59a6ff_0%,_transparent_60%)]"></div>
            <div class="relative z-10">
                <div class="mb-8">
                    <span class="material-symbols-outlined text-[#59a6ff] text-3xl mb-3 block">info</span>
                    <h2 class="font-headline text-2xl text-white mb-4">Información</h2>
                </div>
                <div class="space-y-4">
                    <div class="p-4 rounded-lg bg-white/5 border border-white/10">
                        <p class="text-blue-300/60 text-xs uppercase tracking-widest mb-1">ID de Categoría</p>
                        <p class="text-white font-bold">#@Model.Id</p>
                    </div>
                    <div class="p-4 rounded-lg bg-white/5 border border-white/10">
                        <p class="text-blue-300/60 text-xs uppercase tracking-widest mb-1">Precio Actual</p>
                        <p class="text-[#59a6ff] font-headline text-xl font-bold">RD$@Model.PricePerNight.ToString("N0")</p>
                    </div>
                    <div class="p-4 rounded-lg bg-white/5 border border-white/10">
                        <p class="text-blue-300/60 text-xs uppercase tracking-widest mb-1">Estado</p>
                        @if (Model.IsActive)
                        {
                            <span class="inline-flex items-center gap-2 text-green-400 text-sm font-bold">
                                <span class="w-2 h-2 rounded-full bg-green-400"></span> Activa
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-2 text-red-400 text-sm font-bold">
                                <span class="w-2 h-2 rounded-full bg-red-400"></span> Inactiva
                            </span>
                        }
                    </div>
                </div>

                <div class="mt-8 p-5 rounded-2xl bg-white/5 backdrop-blur-md border border-white/10">
                    <div class="flex items-center gap-3 mb-3">
                        <span class="material-symbols-outlined text-[#59a6ff]">warning</span>
                        <h4 class="text-white text-sm font-bold">Importante</h4>
                    </div>
                    <p class="text-blue-100/60 text-sm">Al desactivar una categoría, no aparecerá en nuevas reservas pero las existentes no se verán afectadas.</p>
                </div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}