@model IReadOnlyList<ReservaDto>

    <h2>Mis Reservas</h2>

    @if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
    @if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

    <a asp-action="Disponibilidad" class="btn btn-primary mb-3">Nueva Reserva</a>

    @if (!Model.Any())
{
    <p>No tienes reservas registradas.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>N° Reserva</th>
                <th>Categoría</th>
                <th>Habitación</th>
                <th>Entrada</th>
                <th>Salida</th>
                <th>Total</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reserva in Model)
            {
            <tr>
                <td>@reserva.NumeroReserva</td>
                <td>@reserva.NombreCategoria</td>
                <td>@reserva.NumeroHabitacion</td>
                <td>@reserva.FechaEntrada.ToString("dd/MM/yyyy")</td>
                <td>@reserva.FechaSalida.ToString("dd/MM/yyyy")</td>
                <td>RD$@reserva.Total.ToString("N2")</td>
                <td>@reserva.Estado</td>
                <td>
                    <a asp-action="Detalle" asp-route-id="@reserva.Id" class="btn btn-sm btn-info">Ver</a>
                    @if (reserva.Estado != "Cancelada" && reserva.Estado != "CheckOut")
                        {
                    <a asp-action="Editar" asp-route-id="@reserva.Id" class="btn btn-sm btn-warning">Editar</a>
                    <form asp-action="Cancelar" method="post" style="display:inline">
                        <input type="hidden" name="id" value="@reserva.Id" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('¿Cancelar esta reserva?')">
                            Cancelar
                        </button>
                    </form>
                        }
                </td>
            </tr>
            }
        </tbody>
    </table>
}
