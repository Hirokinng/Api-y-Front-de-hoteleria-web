@model CrearReservaDto

<h2>Nueva Reserva</h2>

<form asp-action="Crear" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label>ID Cliente</label>
        <input asp-for="IdCliente" class="form-control" />
    </div>
    <div class="mb-3">
        <label>ID Categoría</label>
        <input asp-for="IdCategoria" class="form-control" />
    </div>
    <div class="mb-3">
        <label>ID Habitación</label>
        <input asp-for="IdHabitacion" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Fecha de Entrada</label>
        <input asp-for="FechaEntrada" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Fecha de Salida</label>
        <input asp-for="FechaSalida" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Número de Huéspedes</label>
        <input asp-for="NumeroHuespedes" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Confirmar Reserva</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
