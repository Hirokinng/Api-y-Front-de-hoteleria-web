@model HoteleriaApp.Models.DTOs.ReservaDto

<h2>Detalle de Reserva</h2>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model.NumeroReserva</h5>
        <div class="row">
            <div class="col-md-6">
                <p><strong>Cliente:</strong> @Model.NombreCliente</p>
                <p><strong>Categoría:</strong> @Model.NombreCategoria</p>
                <p><strong>Habitación:</strong> @Model.NumeroHabitacion</p>
                <p><strong>Huéspedes:</strong> @Model.NumeroHuespedes</p>
                <p><strong>Estado:</strong> @Model.Estado</p>
            </div>
            <div class="col-md-6">
                <p><strong>Fecha Entrada:</strong> @Model.FechaEntrada.ToString("dd/MM/yyyy")</p>
                <p><strong>Fecha Salida:</strong> @Model.FechaSalida.ToString("dd/MM/yyyy")</p>
                <p><strong>Noches:</strong> @Model.TotalNoches</p>
                <p><strong>Precio por Noche:</strong> RD$@Model.PrecioBaseNoche.ToString("N2")</p>
                <p><strong>Fecha Creación:</strong> @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>
        @if (Model.Servicios.Any())
        {
        <p><strong>Servicios:</strong> @string.Join(", ", Model.Servicios)</p>
        }
        <hr />
        <p><strong>Subtotal Habitación:</strong> RD$@Model.SubtotalHabitacion.ToString("N2")</p>
        <p><strong>Total Servicios:</strong> RD$@Model.TotalServicios.ToString("N2")</p>
        <h5><strong>Total:</strong> RD$@Model.Total.ToString("N2")</h5>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary">Volver</a>
@if (Model.Estado != "Cancelada" && Model.Estado != "CheckOut")
{
<a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
<form asp-action="Cancelar" method="post" style="display:inline">
    <input type="hidden" name="id" value="@Model.Id" />
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger"
            onclick="return confirm('¿Estás seguro de cancelar esta reserva?')">
        Cancelar Reserva
    </button>
</form>
}