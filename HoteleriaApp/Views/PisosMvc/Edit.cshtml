@{
    ViewData["Title"] = "Pisos";
}

<div class="p-8 lg:p-12 flex flex-col lg:flex-row gap-8 max-w-[1400px] mx-auto">

    <!-- FORM -->
    <div class="flex-1 max-w-3xl">
        <div class="mb-8">
            <div class="flex items-center gap-3 mb-4">
                <a asp-controller="PisosMvc" asp-action="Index" class="p-2 text-secondary hover:text-primary hover:bg-surface-container-low rounded-lg transition-all">
                    <span class="material-symbols-outlined text-sm">arrow_back</span>
                </a>
                <span class="text-secondary text-sm">Pisos</span>
                <span class="material-symbols-outlined text-sm text-outline">chevron_right</span>
                <span class="text-primary text-sm font-medium">Editar Piso</span>
            </div>
            <h2 class="text-4xl lg:text-5xl font-headline text-primary mb-2">Editar Piso</h2>
            <p class="text-secondary">Modifica los datos del piso seleccionado.</p>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-sm border border-outline-variant/20">
            <form asp-controller="PisosMvc" asp-action="Edit" method="post" class="space-y-8">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@ViewBag.Id" />

                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    <div class="md:col-span-1">
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-2">Número de Piso</label>
                        <input name="NumeroPiso" type="number"
                               value="@(ViewBag.Piso.ValueKind != System.Text.Json.JsonValueKind.Undefined ? ViewBag.Piso.GetProperty("numeroPiso").GetInt32() : 0)"
                               class="w-full bg-surface-container-highest border-none rounded-lg py-3 px-4 focus:bg-white focus:ring-2 focus:ring-[#2E86DE]/20 transition-all"/>
                    </div>
                    <div class="md:col-span-3">
                        <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-2">Nombre del Piso</label>
                        <input name="Nombre" type="text"
                               value="@(ViewBag.Piso.ValueKind != System.Text.Json.JsonValueKind.Undefined ? ViewBag.Piso.GetProperty("nombre").GetString() : "")"
                               class="w-full bg-surface-container-highest border-none rounded-lg py-3 px-4 focus:bg-white focus:ring-2 focus:ring-[#2E86DE]/20 transition-all"/>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-secondary uppercase tracking-wider mb-2">Descripción</label>
                    <textarea name="Descripcion" rows="4"
                              class="w-full bg-surface-container-highest border-none rounded-lg py-3 px-4 focus:bg-white focus:ring-2 focus:ring-[#2E86DE]/20 transition-all">@(ViewBag.Piso.ValueKind != System.Text.Json.JsonValueKind.Undefined ? ViewBag.Piso.GetProperty("descripcion").GetString() : "")</textarea>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="p-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">@ViewBag.Error</div>
                }

                <div class="flex items-center justify-between pt-4 border-t border-outline-variant/10">
                    <div class="text-xs text-secondary">
                        ID: <span class="font-bold text-primary">@ViewBag.Id</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <button type="submit"
                                class="bg-[#2E86DE] hover:bg-[#256db5] text-white px-8 py-3 rounded-lg font-semibold shadow-lg shadow-blue-500/20 transition-all active:scale-95">
                            Guardar Cambios
                        </button>
                        <a asp-controller="PisosMvc" asp-action="Index"
                           class="text-secondary hover:text-primary font-medium text-sm transition-colors no-underline">
                            Cancelar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- SIDEBAR -->
    <aside class="w-full lg:w-80">
        <div class="bg-[#002547] text-white rounded-xl p-8 sticky top-24">
            <div class="flex items-center gap-2 mb-6">
                <span class="material-symbols-outlined text-on-primary-container">info</span>
                <h3 class="font-headline text-xl">Información</h3>
            </div>
            <div class="space-y-4">
                <div class="p-4 rounded-lg bg-white/5 border border-white/10">
                    <p class="text-white/50 text-[10px] uppercase tracking-widest font-bold mb-1">ID del Piso</p>
                    <p class="text-white font-mono text-xs break-all">@ViewBag.Id</p>
                </div>
                <div class="p-4 rounded-lg bg-white/5 border border-white/10">
                    <p class="text-white/50 text-[10px] uppercase tracking-widest font-bold mb-1">Número actual</p>
                    <p class="text-on-primary-container font-headline text-2xl font-bold">
                        @(ViewBag.Piso.ValueKind != System.Text.Json.JsonValueKind.Undefined ? ViewBag.Piso.GetProperty("numeroPiso").GetInt32().ToString("D2") : "—")
                    </p>
                </div>
            </div>
            <div class="mt-8 p-5 rounded-2xl bg-white/5 border border-white/10">
                <div class="flex items-center gap-3 mb-3">
                    <span class="material-symbols-outlined text-on-primary-container">warning</span>
                    <h4 class="text-white text-sm font-bold">Importante</h4>
                </div>
                <p class="text-blue-100/60 text-sm">Los cambios en el piso se reflejarán inmediatamente en el panel de disponibilidad de habitaciones.</p>
            </div>
        </div>
    </aside>
</div>
