@{
    ViewData["Title"] = "Gestión de Pisos";
}

<div class="pb-12 px-8 max-w-[1600px] mx-auto space-y-8 pt-8">

    <div class="flex justify-between items-start">
        <div>
            <h1 class="font-headline text-5xl text-primary">Gestión de Pisos</h1>
            <p class="text-secondary mt-2">Organice y supervise la distribución física de su establecimiento desde este panel centralizado.</p>
        </div>
        <a asp-controller="PisosMvc" asp-action="Create"
           class="bg-[#2E86DE] hover:bg-[#2575c0] text-white px-6 py-3 rounded-lg font-medium transition-all flex items-center gap-2 no-underline shadow-lg shadow-blue-500/20">
            <span class="material-symbols-outlined text-sm">add</span>
            Nuevo Piso
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="p-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm flex gap-2">
            <span class="material-symbols-outlined text-sm">error</span>
            @ViewBag.Error
        </div>
    }

    <div class="bg-white rounded-xl border border-outline-variant/20 shadow-sm overflow-hidden">
        <table class="w-full" id="tablaPisos">
            <thead>
                <tr class="bg-[#002547] text-white">
                    <th class="text-left px-6 py-4 text-xs font-bold tracking-widest uppercase opacity-70">N° Piso</th>
                    <th class="text-left px-6 py-4 text-xs font-bold tracking-widest uppercase opacity-70">Nombre</th>
                    <th class="text-left px-6 py-4 text-xs font-bold tracking-widest uppercase opacity-70">Descripción</th>
                    <th class="text-left px-6 py-4 text-xs font-bold tracking-widest uppercase opacity-70 w-28">Acciones</th>
                </tr>
            </thead>
            <tbody id="tbodyPisos" class="divide-y divide-outline-variant/10">
                <tr>
                    <td colspan="4" class="px-6 py-8 text-center text-secondary text-sm" id="mensajeCarga">
                        <span class="material-symbols-outlined animate-spin">refresh</span>
                        Cargando pisos...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" id="bottomCards" style="display:none!important">
        <div class="bg-[#002547] rounded-xl p-8 text-white">
            <h3 class="font-headline text-2xl mb-2 serif-italic">Resumen de Capacidad</h3>
            <p class="text-blue-100/60 text-sm mb-6">Información general de los pisos registrados.</p>
            <div class="flex gap-8">
                <div>
                    <div class="font-headline text-4xl font-bold text-white" id="totalPisos">0</div>
                    <div class="text-xs text-blue-300/60 uppercase tracking-widest mt-1">Total pisos</div>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-xl p-8 border border-outline-variant/20 shadow-sm flex flex-col justify-between">
            <div>
                <div class="w-10 h-10 rounded-lg bg-surface-container-low flex items-center justify-center text-[#2E86DE] mb-4">
                    <span class="material-symbols-outlined">add_circle</span>
                </div>
                <h3 class="font-headline text-xl text-primary mb-2">¿Expandiendo el Hotel?</h3>
                <p class="text-on-surface-variant text-sm leading-relaxed">Registre una nueva planta en el sistema para comenzar a asignar habitaciones y servicios.</p>
            </div>
            <a asp-controller="PisosMvc" asp-action="Create"
               class="mt-6 bg-[#2E86DE] hover:bg-[#2575c0] text-white px-6 py-3 rounded-lg font-medium transition-all flex items-center justify-center gap-2 no-underline">
                <span class="material-symbols-outlined text-sm">add</span>
                Agregar Nuevo Piso
            </a>
        </div>
    </div>
</div>

@section Scripts {
<script>
(async function () {
    try {
        const res = await fetch('/api/Pisos');
        const pisos = await res.json();
        const tbody = document.getElementById('tbodyPisos');
        const msg = document.getElementById('mensajeCarga');

        if (!res.ok || pisos.length === 0) {
            msg.innerHTML = '<span class="material-symbols-outlined">layers</span> No hay pisos registrados.';
            return;
        }

        msg.closest('tr').remove();
        document.getElementById('totalPisos').textContent = pisos.length;
        document.getElementById('bottomCards').style.display = '';

        pisos.forEach(p => {
            tbody.innerHTML += `
            <tr class="hover:bg-surface-container-low transition-colors">
                <td class="px-6 py-5 font-medium text-secondary text-sm">${String(p.numeroPiso).padStart(2,'0')}</td>
                <td class="px-6 py-5 font-bold text-primary">${p.nombre}</td>
                <td class="px-6 py-5 text-on-surface-variant text-sm">${p.descripcion || '—'}</td>
                <td class="px-6 py-5">
                    <div class="flex items-center gap-2">
                        <a href="/PisosMvc/Edit/${p.id}"
                           class="p-2 text-secondary hover:text-[#2E86DE] hover:bg-surface-container-low rounded-lg transition-all">
                            <span class="material-symbols-outlined text-sm">edit</span>
                        </a>
                        <form method="post" action="/PisosMvc/Delete" onsubmit="return confirm('¿Eliminar este piso?')">
                            <input type="hidden" name="id" value="${p.id}" />
                            <button type="submit" class="p-2 text-secondary hover:text-red-500 hover:bg-red-50 rounded-lg transition-all">
                                <span class="material-symbols-outlined text-sm">delete</span>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>`;
        });
    } catch (e) {
        document.getElementById('mensajeCarga').textContent = 'Error al cargar pisos: ' + e.message;
    }
})();
</script>
}
