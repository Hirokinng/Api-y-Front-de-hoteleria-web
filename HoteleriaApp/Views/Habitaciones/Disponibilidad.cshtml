@{
    ViewData["Title"] = "Disponibilidad de Habitaciones";
}

<div class="pb-12 px-8 max-w-[1100px] mx-auto space-y-8 pt-8">

    <!-- HEADER -->
    <div class="flex justify-between items-center">
        <div>
            <p class="text-xs font-bold text-secondary tracking-widest uppercase mb-2">
                GESTIÓN HOTELERA
            </p>
            <h1 class="font-headline text-4xl text-primary">
                Buscar Habitaciones Disponibles
            </h1>
        </div>

        <a asp-action="Index"
           class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-5 py-2 rounded-lg text-sm font-medium no-underline">
            ← Volver al Inventario
        </a>
    </div>

    <!-- FORM CARD -->
    <div class="bg-white rounded-xl border border-outline-variant/20 shadow-sm p-6">
        <form id="frmDisponibilidad" class="grid grid-cols-1 md:grid-cols-5 gap-4">

            <div>
                <label class="text-xs text-secondary uppercase">Check-in</label>
                <input type="date"
                       class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#2E86DE]"
                       id="fechaInicio" required />
            </div>

            <div>
                <label class="text-xs text-secondary uppercase">Check-out</label>
                <input type="date"
                       class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#2E86DE]"
                       id="fechaFin" required />
            </div>

            <div>
                <label class="text-xs text-secondary uppercase">Tipo</label>
                <select id="tipoHabitacionId"
                        class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#2E86DE]">
                    <option value="">Todos</option>
                </select>
            </div>

            <div>
                <label class="text-xs text-secondary uppercase">Capacidad mín.</label>
                <input type="number"
                       class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#2E86DE]"
                       id="capacidadMinima" min="1" placeholder="Ej. 2" />
            </div>

            <div class="flex items-end">
                <button type="submit"
                        class="w-full bg-[#2E86DE] hover:bg-[#1B4F72] text-white px-4 py-2 rounded-lg text-sm font-medium transition">
                    Buscar
                </button>
            </div>

        </form>
    </div>

    <!-- TABLE -->
    <div class="bg-white rounded-xl border border-outline-variant/20 shadow-sm overflow-hidden">

        <div class="overflow-x-auto">
            <table class="min-w-full text-sm" id="tablaDisponibles">

                <thead class="bg-gray-100 text-left text-xs uppercase text-gray-600">
                    <tr>
                        <th class="px-6 py-4">Número</th>
                        <th class="px-6 py-4">Piso</th>
                        <th class="px-6 py-4">Tipo</th>
                        <th class="px-6 py-4">Capacidad</th>
                        <th class="px-6 py-4">Amenities</th>
                    </tr>
                </thead>

                <tbody class="divide-y"></tbody>

            </table>
        </div>

    </div>

    <!-- MENSAJES -->
    <div class="text-gray-500 text-sm" id="mensajeDisponibles"></div>

    <div class="bg-red-100 text-red-600 px-4 py-3 rounded-lg text-sm hidden" id="mensajeErrorDisp"></div>

</div>

@section Scripts {
    <script>
        const hoy = new Date();
        document.getElementById('fechaHoy').textContent = hoy.toLocaleDateString('es-DO', { day: 'numeric', month: 'long' });

        (async function () {
            try {
                const res = await fetch('/api/habitaciones/tipos');
                const tipos = await res.json();
                const sel = document.getElementById('tipoHabitacionId');

                tipos.forEach(t => {
                    sel.innerHTML += `<option value="${t.id}">${t.nombre}</option>`;
                });
            } catch (e) { console.error(e); }
        })();

        document.getElementById('frmDisponibilidad').addEventListener('submit', async e => {
            e.preventDefault();

            const fechaInicio = document.getElementById('fechaInicio').value;
            const fechaFin = document.getElementById('fechaFin').value;
            const tipoId = document.getElementById('tipoHabitacionId').value;
            const capacidad = document.getElementById('capacidadMinima').value;

            const url = `/api/habitaciones/disponibles?fechaInicio=${fechaInicio}&fechaFin=${fechaFin}` +
                `${tipoId ? `&tipoHabitacionId=${tipoId}` : ''}` +
                `${capacidad ? `&capacidadMinima=${capacidad}` : ''}`;

            const btn = document.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.textContent = 'Buscando...';

            try {
                const res = await fetch(url);
                const habitaciones = await res.json();

                const tbody = document.querySelector('#tablaDisponibles tbody');
                tbody.innerHTML = '';

                document.getElementById('mensajeErrorDisp').classList.add('hidden');

                if (habitaciones.length === 0) {
                    document.getElementById('mensajeDisponibles').textContent =
                        'No hay habitaciones disponibles para las fechas seleccionadas.';
                } else {
                    document.getElementById('mensajeDisponibles').textContent =
                        habitaciones.length + ' habitación(es) disponible(s).';

                    habitaciones.forEach(h => {
                        const amenities = (h.amenities || [])
                            .map(a => a.amenity?.nombre || '')
                            .filter(Boolean)
                            .join(', ') || '-';

                        tbody.innerHTML += `
                                <tr class="hover:bg-gray-50 transition">
                                    <td class="px-6 py-4 font-medium">${h.numero}</td>
                                    <td class="px-6 py-4">${h.piso}</td>
                                    <td class="px-6 py-4">${h.tipoHabitacion?.nombre || '-'}</td>
                                    <td class="px-6 py-4">${h.capacidad}</td>
                                    <td class="px-6 py-4 text-gray-600">${amenities}</td>
                                </tr>
                            `;
                    });
                }

            } catch (e) {
                const error = document.getElementById('mensajeErrorDisp');
                error.classList.remove('hidden');
                error.textContent = 'Error: ' + e.message;
            } finally {
                btn.disabled = false;
                btn.textContent = 'Buscar';
            }
        });
    </script>
}