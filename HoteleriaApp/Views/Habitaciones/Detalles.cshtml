@{
    ViewData["Title"] = "Detalles de Habitación";
    var habitacionId = ViewData["HabitacionId"];
}

<div class="pb-12 px-8 max-w-[1200px] mx-auto space-y-8 pt-8">

    <div>
        <a asp-action="Index" class="text-[#2E86DE] flex items-center gap-2 mb-4 hover:underline w-max no-underline text-sm font-medium">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Volver al inventario
        </a>
        <p class="text-xs font-bold text-secondary tracking-widest uppercase mb-2">GESTIÓN DE HABITACIONES</p>
        <h1 class="font-headline text-4xl text-primary" id="headerTitle">Detalles de Habitación</h1>
    </div>

    <!-- Loading -->
    <div id="loadingState" class="bg-white rounded-xl border border-outline-variant/20 shadow-sm flex flex-col items-center justify-center py-24 text-center">
        <div class="w-12 h-12 rounded-full border-4 border-[#2E86DE]/20 border-t-[#2E86DE] animate-spin mb-4"></div>
        <p class="text-secondary text-sm">Cargando detalles de la habitación...</p>
    </div>

    <!-- Error -->
    <div id="errorState" class="hidden bg-white rounded-xl border border-red-200 shadow-sm flex flex-col items-center justify-center py-24 text-center">
        <div class="w-16 h-16 rounded-full bg-red-50 flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-3xl text-red-500">error</span>
        </div>
        <h3 class="font-headline text-2xl text-primary mb-2">Error al cargar datos</h3>
        <p class="text-secondary text-sm" id="errorMessage"></p>
    </div>

    <!-- Content -->
    <div id="contentArea" class="hidden space-y-8">

        <!-- Room Info Card -->
        <div class="bg-white rounded-xl border border-outline-variant/20 shadow-sm p-8">
            <h2 class="font-headline text-2xl text-primary mb-6 flex items-center gap-2">
                <span class="material-symbols-outlined">hotel</span>
                Información General
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                    <p class="text-xs font-bold text-secondary uppercase tracking-wide mb-1">Número</p>
                    <p class="text-lg font-bold text-primary" id="infoNumero">-</p>
                </div>
                <div>
                    <p class="text-xs font-bold text-secondary uppercase tracking-wide mb-1">Piso</p>
                    <p class="text-lg font-bold text-primary" id="infoPiso">-</p>
                </div>
                <div>
                    <p class="text-xs font-bold text-secondary uppercase tracking-wide mb-1">Tipo</p>
                    <p class="text-lg font-bold text-primary" id="infoTipo">-</p>
                </div>
                <div>
                    <p class="text-xs font-bold text-secondary uppercase tracking-wide mb-1">Capacidad</p>
                    <p class="text-lg font-bold text-primary" id="infoCapacidad">-</p>
                </div>
                <div>
                    <p class="text-xs font-bold text-secondary uppercase tracking-wide mb-1">Estado</p>
                    <p id="infoEstado">-</p>
                </div>
                <div>
                    <p class="text-xs font-bold text-secondary uppercase tracking-wide mb-1">Categoría</p>
                    <p class="text-lg font-bold text-primary" id="infoCategoria">-</p>
                </div>
            </div>
        </div>

        <!-- Amenities -->
        <div class="bg-white rounded-xl border border-outline-variant/20 shadow-sm p-8" id="amenitiesCard">
            <h2 class="font-headline text-2xl text-primary mb-6 flex items-center gap-2">
                <span class="material-symbols-outlined">star</span>
                Amenities
            </h2>
            <div id="amenitiesList" class="flex flex-wrap gap-2">
                <p class="text-secondary text-sm">Sin amenities registrados.</p>
            </div>
        </div>

        <!-- Occupancy Calendar -->
        <div class="bg-white rounded-xl border border-outline-variant/20 shadow-sm p-8">
            <h2 class="font-headline text-2xl text-primary mb-6 flex items-center gap-2">
                <span class="material-symbols-outlined">calendar_month</span>
                Calendario de Ocupación
            </h2>

            <!-- Calendar Navigation -->
            <div class="flex items-center justify-between mb-6">
                <button id="prevMonth" class="p-2 text-secondary hover:text-[#2E86DE] hover:bg-surface-container-low rounded-lg transition-all">
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>
                <h3 class="font-headline text-xl text-primary" id="calendarTitle"></h3>
                <button id="nextMonth" class="p-2 text-secondary hover:text-[#2E86DE] hover:bg-surface-container-low rounded-lg transition-all">
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            </div>

            <!-- Day Headers -->
            <div class="grid grid-cols-7 gap-1 mb-1">
                <div class="text-center text-xs font-bold text-secondary uppercase tracking-wide py-2">Lun</div>
                <div class="text-center text-xs font-bold text-secondary uppercase tracking-wide py-2">Mar</div>
                <div class="text-center text-xs font-bold text-secondary uppercase tracking-wide py-2">Mié</div>
                <div class="text-center text-xs font-bold text-secondary uppercase tracking-wide py-2">Jue</div>
                <div class="text-center text-xs font-bold text-secondary uppercase tracking-wide py-2">Vie</div>
                <div class="text-center text-xs font-bold text-secondary uppercase tracking-wide py-2">Sáb</div>
                <div class="text-center text-xs font-bold text-secondary uppercase tracking-wide py-2">Dom</div>
            </div>

            <!-- Calendar Grid -->
            <div class="grid grid-cols-7 gap-1" id="calendarGrid"></div>

            <!-- Legend -->
            <div class="flex flex-wrap items-center gap-6 mt-6 pt-6 border-t border-outline-variant/10">
                <div class="flex items-center gap-2">
                    <div class="w-4 h-4 rounded bg-green-200 border border-green-300"></div>
                    <span class="text-xs text-secondary">Disponible</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-4 h-4 rounded bg-red-200 border border-red-300"></div>
                    <span class="text-xs text-secondary">Ocupada (Reserva)</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-4 h-4 rounded bg-orange-200 border border-orange-300"></div>
                    <span class="text-xs text-secondary">Bloqueada</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-4 h-4 rounded bg-gray-200 border border-gray-300"></div>
                    <span class="text-xs text-secondary">Pasado</span>
                </div>
            </div>
        </div>

    </div>

</div>

<!-- Tooltip -->
<div id="tooltip" class="fixed hidden bg-[#002547] text-white text-xs rounded-lg px-3 py-2 shadow-lg z-50 pointer-events-none max-w-xs"></div>

@section Scripts {
    <script>
        const habitacionId = '@habitacionId';
        let habitacionData = null;
        let currentYear, currentMonth;

        (async function () {
            try {
                const res = await fetch(`/api/habitaciones/${habitacionId}`);
                if (!res.ok) throw new Error(`HTTP ${res.status}: ${res.statusText}`);
                habitacionData = await res.json();

                document.getElementById('loadingState').classList.add('hidden');
                document.getElementById('contentArea').classList.remove('hidden');

                renderInfo(habitacionData);
                renderAmenities(habitacionData);

                const now = new Date();
                currentYear = now.getFullYear();
                currentMonth = now.getMonth();
                renderCalendar();

            } catch (e) {
                document.getElementById('loadingState').classList.add('hidden');
                document.getElementById('errorState').classList.remove('hidden');
                document.getElementById('errorMessage').textContent = e.message;
            }
        })();

        function renderInfo(h) {
            document.getElementById('headerTitle').textContent = `Habitación ${h.numero}`;
            document.getElementById('infoNumero').textContent = h.numero;
            document.getElementById('infoPiso').textContent = h.piso;
            document.getElementById('infoTipo').textContent = h.tipoHabitacion?.nombre || '-';
            document.getElementById('infoCapacidad').textContent = `${h.capacidad} persona(s)`;
            document.getElementById('infoCategoria').textContent = h.categoria?.name || h.idCategoria || '-';

            const estadoMap = {
                0: { text: 'Disponible', bg: 'bg-green-100', color: 'text-green-700' },
                1: { text: 'Ocupada', bg: 'bg-amber-100', color: 'text-amber-700' },
                2: { text: 'Fuera de servicio', bg: 'bg-gray-100', color: 'text-gray-600' }
            };
            const estado = estadoMap[h.estado] || estadoMap[2];
            document.getElementById('infoEstado').innerHTML =
                `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold ${estado.bg} ${estado.color}">${estado.text}</span>`;
        }

        function renderAmenities(h) {
            const amenities = (h.amenities || []).map(a => a.amenity?.nombre || a.nombre).filter(Boolean);
            const container = document.getElementById('amenitiesList');
            if (amenities.length === 0) return;
            container.innerHTML = amenities.map(a =>
                `<span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-blue-50 text-[#2E86DE] border border-blue-100">${a}</span>`
            ).join('');
        }

        function renderCalendar() {
            const monthNames = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
                'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
            document.getElementById('calendarTitle').textContent = `${monthNames[currentMonth]} ${currentYear}`;

            const grid = document.getElementById('calendarGrid');
            grid.innerHTML = '';

            const firstDay = new Date(currentYear, currentMonth, 1);
            const lastDay = new Date(currentYear, currentMonth + 1, 0);
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            // Monday-based: getDay() returns 0=Sun, we want 0=Mon
            let startDow = firstDay.getDay() - 1;
            if (startDow < 0) startDow = 6;

            // Empty cells before first day
            for (let i = 0; i < startDow; i++) {
                const cell = document.createElement('div');
                cell.className = 'h-10';
                grid.appendChild(cell);
            }

            const reservas = habitacionData.reservas || [];
            const bloqueos = habitacionData.bloqueos || [];

            for (let day = 1; day <= lastDay.getDate(); day++) {
                const date = new Date(currentYear, currentMonth, day);
                date.setHours(0, 0, 0, 0);
                const cell = document.createElement('div');
                cell.className = 'h-10 flex items-center justify-center rounded text-sm font-medium cursor-default transition-all';
                cell.textContent = day;

                let tooltipText = '';

                if (date < today) {
                    cell.classList.add('bg-gray-100', 'text-gray-400', 'border', 'border-gray-200');
                } else {
                    // Check blockages first
                    const bloqueo = bloqueos.find(b => {
                        const inicio = new Date(b.fechaInicio);
                        const fin = new Date(b.fechaFin);
                        inicio.setHours(0, 0, 0, 0);
                        fin.setHours(0, 0, 0, 0);
                        return date >= inicio && date <= fin;
                    });

                    // Check reservations
                    const reserva = reservas.find(r => {
                        const entrada = new Date(r.reserva?.fechaEntrada || r.fechaEntrada);
                        const salida = new Date(r.reserva?.fechaSalida || r.fechaSalida);
                        entrada.setHours(0, 0, 0, 0);
                        salida.setHours(0, 0, 0, 0);
                        return date >= entrada && date <= salida;
                    });

                    if (bloqueo) {
                        cell.classList.add('bg-orange-200', 'text-orange-800', 'border', 'border-orange-300', 'hover:bg-orange-300');
                        tooltipText = `Bloqueada: ${bloqueo.motivo || 'Sin motivo'}`;
                    } else if (reserva) {
                        cell.classList.add('bg-red-200', 'text-red-800', 'border', 'border-red-300', 'hover:bg-red-300');
                        const numReserva = reserva.reserva?.numeroReserva || reserva.numeroReserva || 'N/A';
                        tooltipText = `Reserva #${numReserva}`;
                    } else {
                        cell.classList.add('bg-green-100', 'text-green-700', 'border', 'border-green-200', 'hover:bg-green-200');
                    }
                }

                if (tooltipText) {
                    cell.addEventListener('mouseenter', function (e) {
                        const tooltip = document.getElementById('tooltip');
                        tooltip.textContent = tooltipText;
                        tooltip.classList.remove('hidden');
                        tooltip.style.left = e.pageX + 10 + 'px';
                        tooltip.style.top = e.pageY - 30 + 'px';
                    });
                    cell.addEventListener('mousemove', function (e) {
                        const tooltip = document.getElementById('tooltip');
                        tooltip.style.left = e.pageX + 10 + 'px';
                        tooltip.style.top = e.pageY - 30 + 'px';
                    });
                    cell.addEventListener('mouseleave', function () {
                        document.getElementById('tooltip').classList.add('hidden');
                    });
                }

                grid.appendChild(cell);
            }
        }

        document.getElementById('prevMonth').addEventListener('click', function () {
            currentMonth--;
            if (currentMonth < 0) { currentMonth = 11; currentYear--; }
            renderCalendar();
        });

        document.getElementById('nextMonth').addEventListener('click', function () {
            currentMonth++;
            if (currentMonth > 11) { currentMonth = 0; currentYear++; }
            renderCalendar();
        });
    </script>
}
