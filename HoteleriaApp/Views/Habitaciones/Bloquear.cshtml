@{
    ViewData["Title"] = "Bloquear Habitación";
}

<div class="pb-12 px-8 max-w-[1600px] mx-auto pt-8">
    <div class="flex gap-12">

     
        <div class="flex-1 space-y-10">

           
            <div>
                <p class="text-xs font-bold text-secondary tracking-widest uppercase mb-2">GESTIÓN DE INVENTARIO</p>
                <h1 class="font-headline text-4xl font-bold text-primary">Restricción de Inventario</h1>
                <p class="mt-3 text-secondary text-sm max-w-lg leading-relaxed">
                    Utilice este formulario para retirar temporalmente una unidad de la disponibilidad activa.
                    Los bloqueos afectan directamente al motor de reservas y canales OTA.
                </p>
            </div>

     
            <div class="bg-white rounded-xl border border-outline-variant/20 shadow-sm p-10 space-y-8">

                <form id="frmBloquear" class="space-y-8">

                    <div class="space-y-2">
                        <label class="block text-xs font-bold tracking-widest text-on-surface-variant uppercase">Habitación</label>
                        <div class="relative">
                            <select id="habitacionId" required
                                    class="w-full appearance-none bg-surface-container-highest border-none rounded-lg p-4 pr-12 text-on-surface text-base cursor-pointer focus:ring-2 focus:ring-primary/20 outline-none transition-all">
                                <option value="" disabled selected>Seleccione una habitación...</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-secondary">expand_more</span>
                        </div>
                    </div>

                    
                    <div class="grid grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="block text-xs font-bold tracking-widest text-on-surface-variant uppercase">Fecha Inicio</label>
                            <input type="date" id="fechaInicio" required
                                   class="w-full bg-surface-container-highest border-none rounded-lg p-4 focus:ring-2 focus:ring-primary/20 outline-none transition-all text-on-surface" />
                        </div>
                        <div class="space-y-2">
                            <label class="block text-xs font-bold tracking-widest text-on-surface-variant uppercase">Fecha Fin</label>
                            <input type="date" id="fechaFin" required
                                   class="w-full bg-surface-container-highest border-none rounded-lg p-4 focus:ring-2 focus:ring-primary/20 outline-none transition-all text-on-surface" />
                        </div>
                    </div>

             
                    <div class="space-y-3">
                        <label class="block text-xs font-bold tracking-widest text-on-surface-variant uppercase">Tipo de Bloqueo</label>
                        <div class="grid grid-cols-3 gap-4">
                            <label class="cursor-pointer">
                                <input type="radio" name="tipoBloqueo" value="0" class="hidden peer" />
                                <div class="p-4 rounded-xl bg-surface-container-highest text-center border-2 border-transparent peer-checked:border-primary peer-checked:bg-white transition-all">
                                    <span class="material-symbols-outlined block mb-1 text-secondary">build</span>
                                    <span class="text-sm font-medium text-on-surface-variant">Mantenimiento</span>
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="tipoBloqueo" value="1" class="hidden peer" />
                                <div class="p-4 rounded-xl bg-surface-container-highest text-center border-2 border-transparent peer-checked:border-primary peer-checked:bg-white transition-all">
                                    <span class="material-symbols-outlined block mb-1 text-secondary">celebration</span>
                                    <span class="text-sm font-medium text-on-surface-variant">Evento especial</span>
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="tipoBloqueo" value="2" class="hidden peer" />
                                <div class="p-4 rounded-xl bg-surface-container-highest text-center border-2 border-transparent peer-checked:border-primary peer-checked:bg-white transition-all">
                                    <span class="material-symbols-outlined block mb-1 text-secondary">more_horiz</span>
                                    <span class="text-sm font-medium text-on-surface-variant">Otro</span>
                                </div>
                            </label>
                        </div>
                    </div>

              
                    <div class="space-y-2">
                        <label class="block text-xs font-bold tracking-widest text-on-surface-variant uppercase">Motivo</label>
                        <textarea id="motivo" rows="4" required
                                  placeholder="Describa el detalle del bloqueo para el equipo de recepción..."
                                  class="w-full bg-surface-container-highest border-none rounded-lg p-4 focus:ring-2 focus:ring-primary/20 outline-none transition-all resize-none text-on-surface text-sm"></textarea>
                    </div>

           
                    <div class="pt-2 flex items-center gap-4">
                        <button type="submit"
                                class="px-10 py-4 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-lg shadow-amber-500/20 transition-all flex items-center gap-2 active:scale-[0.98]">
                            <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;">lock</span>
                            Bloquear Habitación
                        </button>
                        <a asp-action="Index"
                           class="text-sm text-secondary hover:text-primary no-underline transition-colors">
                            Cancelar
                        </a>
                    </div>
                </form>

             
                <div id="mensajeOk" class="hidden flex items-center gap-4 bg-emerald-50 text-emerald-800 p-5 rounded-lg border border-emerald-100/50">
                    <span class="material-symbols-outlined text-emerald-600" style="font-variation-settings:'FILL' 1;">check_circle</span>
                    <p class="font-medium text-sm"></p>
                </div>

          
                <div id="mensajeErr" class="hidden flex items-center gap-4 bg-red-50 text-red-800 p-5 rounded-lg border border-red-100/50">
                    <span class="material-symbols-outlined text-red-500" style="font-variation-settings:'FILL' 1;">error</span>
                    <p class="font-medium text-sm"></p>
                </div>
            </div>

        </div>

     
        <aside class="w-80 flex-shrink-0">
            <div class="bg-[#002547] rounded-2xl p-8 text-white sticky top-24 space-y-8 overflow-hidden">

                <h3 class="font-headline text-2xl font-bold border-b border-white/10 pb-4">Política de Bloqueo</h3>
                <p class="text-white/60 text-sm leading-relaxed">
                    Los bloqueos son herramientas críticas para la gestión operativa. Por favor, asegúrese de seguir los lineamientos de la propiedad:
                </p>

                <ul class="space-y-7">
                    <li class="flex gap-4">
                        <span class="material-symbols-outlined text-[#59a6ff] flex-shrink-0">verified_user</span>
                        <div>
                            <p class="text-sm font-semibold mb-1">Autorización</p>
                            <p class="text-xs text-white/50 leading-relaxed">Bloqueos mayores a 48 horas requieren aprobación de la Gerencia de Operaciones.</p>
                        </div>
                    </li>
                    <li class="flex gap-4">
                        <span class="material-symbols-outlined text-[#59a6ff] flex-shrink-0">sync_alt</span>
                        <div>
                            <p class="text-sm font-semibold mb-1">Sincronización OTA</p>
                            <p class="text-xs text-white/50 leading-relaxed">El inventario se actualizará automáticamente en Booking.com y Expedia en menos de 120 segundos.</p>
                        </div>
                    </li>
                    <li class="flex gap-4">
                        <span class="material-symbols-outlined text-[#59a6ff] flex-shrink-0">history</span>
                        <div>
                            <p class="text-sm font-semibold mb-1">Auditoría</p>
                            <p class="text-xs text-white/50 leading-relaxed">Cada bloqueo queda registrado con el ID del usuario para auditorías mensuales de Revenue.</p>
                        </div>
                    </li>
                </ul>

             
                <div class="bg-white/5 p-5 rounded-xl border border-white/10">
                    <div class="flex items-center gap-2 mb-3">
                        <span class="material-symbols-outlined text-amber-400" style="font-variation-settings:'FILL' 1;">warning</span>
                        <p class="text-sm font-bold">Estado del Sistema</p>
                    </div>
                    <p class="text-xs text-white/60 leading-relaxed italic" id="estadoSistema">
                        Cargando estado del inventario...
                    </p>
                </div>

            </div>
        </aside>

    </div>
</div>

@section Scripts {
    <script>
      
        (async function () {
            try {
                const res = await fetch('/api/habitaciones');
                const habitaciones = await res.json();
                const sel = document.getElementById('habitacionId');
                const enMantenimiento = habitaciones.filter(h => h.estado === 2).length;

                habitaciones.forEach(h => {
                    sel.innerHTML += `<option value="${h.id}">${h.numero} - ${h.tipoHabitacion?.nombre || '—'} (Piso ${h.piso})</option>`;
                });

                document.getElementById('estadoSistema').textContent =
                    `Actualmente hay ${enMantenimiento} habitación(es) bloqueada(s) por mantenimiento.`;

            } catch (e) {
                document.getElementById('estadoSistema').textContent = 'Error al cargar estado del sistema.';
            }
        })();

        document.getElementById('frmBloquear').addEventListener('submit', async e => {
            e.preventDefault();
            ocultarAlertas();

            const habitacionId = document.getElementById('habitacionId').value;
            const fechaInicio  = document.getElementById('fechaInicio').value;
            const fechaFin     = document.getElementById('fechaFin').value;
            const tipoBloqueo  = document.querySelector('input[name="tipoBloqueo"]:checked')?.value;
            const motivo       = document.getElementById('motivo').value;

            try {
                const res = await fetch('/api/habitaciones/bloquear', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ habitacionId, fechaInicio, fechaFin, tipo: parseInt(tipoBloqueo), motivo })
                });
                const data = await res.json().catch(() => ({}));

                if (res.ok) {
                    mostrarOk(data.message || 'Habitación bloqueada correctamente.');
                    document.getElementById('frmBloquear').reset();
                } else {
                    mostrarError(typeof data === 'string' ? data : (data.message || data.detail || data.title || 'Error al bloquear.'));
                }
            } catch (e) {
                mostrarError('Error: ' + e.message);
            }
        });

        function ocultarAlertas() {
            document.getElementById('mensajeOk').classList.add('hidden');
            document.getElementById('mensajeErr').classList.add('hidden');
        }
        function mostrarOk(msg) {
            const el = document.getElementById('mensajeOk');
            el.querySelector('p').textContent = msg;
            el.classList.remove('hidden');
        }
        function mostrarError(msg) {
            const el = document.getElementById('mensajeErr');
            el.querySelector('p').textContent = msg;
            el.classList.remove('hidden');
        }
    </script>
}
