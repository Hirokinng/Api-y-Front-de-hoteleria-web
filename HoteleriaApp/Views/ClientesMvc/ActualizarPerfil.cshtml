@{
    ViewData["Title"] = "Clientes";
    Layout = "_LayoutCliente";
}

<div class="ml-0 mt-0 p-8 min-h-screen flex gap-8 max-w-[1400px] mx-auto">

    <section class="flex-grow max-w-3xl">
        <div class="mb-10">
            <div class="flex items-center gap-3 mb-4">
                <a asp-action="Perfil" class="p-2 text-secondary hover:text-primary hover:bg-surface-container-low rounded-lg transition-all">
                    <span class="material-symbols-outlined text-sm">arrow_back</span>
                </a>
                <span class="text-secondary text-sm">Clientes</span>
                <span class="material-symbols-outlined text-sm text-outline">chevron_right</span>
                <span class="text-primary text-sm font-medium">Editar Perfil</span>
            </div>
            <h1 class="font-headline text-5xl text-primary leading-tight">Editar Perfil</h1>
            <p class="text-secondary mt-2 text-lg">Actualice su información personal y preferencias de contacto.</p>
        </div>

        <div class="bg-white p-10 rounded-xl shadow-sm border border-outline-variant/20">
            <form asp-controller="ClientesMvc" asp-action="ActualizarPerfil" method="post" class="space-y-8">
                @Html.AntiForgeryToken()
                <div class="grid grid-cols-1 gap-8">
                    <div class="space-y-2">
                        <label class="block text-xs font-bold uppercase tracking-widest text-secondary">Nombre</label>
                        <input name="Nombre" type="text" value="@ViewBag.NombreCliente"
                               class="w-full bg-surface-container-highest border-none rounded-lg py-4 px-5 text-on-surface focus:bg-white focus:ring-2 focus:ring-primary/10 transition-all text-lg font-medium"/>
                    </div>
                    <div class="space-y-2">
                        <label class="block text-xs font-bold uppercase tracking-widest text-secondary">Email</label>
                        <input name="Email" type="email" value="@ViewBag.EmailCliente"
                               class="w-full bg-surface-container-highest border-none rounded-lg py-4 px-5 text-on-surface focus:bg-white focus:ring-2 focus:ring-primary/10 transition-all text-lg font-medium"/>
                    </div>
                    <div class="space-y-2">
                        <label class="block text-xs font-bold uppercase tracking-widest text-secondary">Teléfono</label>
                        <input name="Telefono" type="tel" value="@ViewBag.TelefonoCliente"
                               class="w-full bg-surface-container-highest border-none rounded-lg py-4 px-5 text-on-surface focus:bg-white focus:ring-2 focus:ring-primary/10 transition-all text-lg font-medium"/>
                    </div>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="p-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">@ViewBag.Error</div>
                }
                @if (ViewBag.Success != null)
                {
                    <div class="p-3 rounded-lg bg-green-50 border border-green-200 text-green-700 text-sm">@ViewBag.Success</div>
                }

                <div class="pt-6 flex justify-end gap-4">
                    <a asp-action="Perfil" class="px-8 py-3 text-primary font-medium hover:bg-surface-container-low rounded-lg transition-colors no-underline">
                        Cancelar
                    </a>
                    <button type="submit"
                            class="bg-[#2E86DE] hover:bg-[#2572bd] text-white px-10 py-3 rounded-lg font-semibold shadow-lg shadow-blue-500/20 transition-all active:scale-95">
                        Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </section>

    <aside class="w-96 flex flex-col gap-6 flex-shrink-0">
        <div class="bg-[#002547] text-white rounded-xl p-8 shadow-xl overflow-hidden relative">
            <div class="absolute -top-10 -right-10 w-40 h-40 bg-white/5 rounded-full blur-3xl"></div>
            <div class="relative z-10 flex flex-col items-center text-center">
                <div class="w-20 h-20 rounded-full border-2 border-on-primary-container flex items-center justify-center mb-4 bg-white/10">
                    <span class="material-symbols-outlined text-3xl text-on-primary-container">person</span>
                </div>
                <h3 class="font-headline text-2xl mb-1">@ViewBag.NombreCliente</h3>
                <p class="text-on-primary-container text-xs uppercase tracking-widest mb-6">Cliente Registrado</p>
                <div class="w-full space-y-4 text-left border-t border-white/10 pt-6">
                    <div>
                        <p class="text-white/50 text-[10px] uppercase tracking-widest font-bold mb-1">Email actual</p>
                        <p class="font-medium text-sm">@ViewBag.EmailCliente</p>
                    </div>
                    <div>
                        <p class="text-white/50 text-[10px] uppercase tracking-widest font-bold mb-1">Teléfono actual</p>
                        <p class="font-medium text-sm">@(ViewBag.TelefonoCliente ?? "—")</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="bg-surface-container-high rounded-xl p-6 border border-outline-variant/20">
            <h4 class="text-xs font-bold uppercase tracking-widest text-secondary mb-4">Nota</h4>
            <p class="text-sm text-secondary leading-relaxed">
                Los cambios en su perfil se aplicarán de inmediato. Su email es su identificador de acceso al sistema.
            </p>
        </div>
    </aside>
</div>
