@{
    ViewData["Title"] = "Clientes";
}

<section class="mt-0 flex-1 flex overflow-hidden max-w-[1400px] mx-auto w-full">

    <div class="flex-1 overflow-y-auto p-12 bg-surface">
        <div class="max-w-2xl mx-auto">
            <div class="flex items-center gap-3 mb-8">
                <a asp-action="Perfil" class="p-2 text-secondary hover:text-primary hover:bg-surface-container-low rounded-lg transition-all">
                    <span class="material-symbols-outlined text-sm">arrow_back</span>
                </a>
                <span class="text-secondary text-sm">Clientes</span>
                <span class="material-symbols-outlined text-sm text-outline">chevron_right</span>
                <span class="text-primary text-sm font-medium">Cambiar Contraseña</span>
            </div>

            <header class="mb-12">
                <h3 class="font-headline text-4xl text-primary mb-4">Actualizar Credenciales</h3>
                <p class="text-secondary max-w-md leading-relaxed">
                    Para garantizar la seguridad de su cuenta, le recomendamos renovar su contraseña periódicamente.
                </p>
            </header>

            <form asp-controller="ClientesMvc" asp-action="CambiarPassword" method="post" class="space-y-10">
                @Html.AntiForgeryToken()
                <div class="space-y-6">

                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-widest mb-3">Contraseña Actual</label>
                        <div class="relative group">
                            <input id="passActual" name="PasswordActual" type="password" placeholder="••••••••"
                                   class="w-full bg-surface-container-highest border-none px-6 py-4 rounded-lg focus:ring-1 focus:ring-primary/20 focus:bg-white transition-all text-primary"/>
                            <span onclick="togglePass('passActual', this)"
                                  class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 cursor-pointer z-10 select-none">visibility</span>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-widest mb-3">Nueva Contraseña</label>
                        <div class="relative group mb-3">
                            <input id="passNueva" name="NuevaPassword" type="password" placeholder="Cree una contraseña segura"
                                   class="w-full bg-surface-container-highest border-none px-6 py-4 rounded-lg focus:ring-1 focus:ring-primary/20 focus:bg-white transition-all text-primary"/>
                            <span onclick="togglePass('passNueva', this)"
                                  class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 cursor-pointer z-10 select-none">visibility</span>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between items-center px-1">
                                <span class="text-[10px] text-slate-400 uppercase font-medium">Fortaleza de seguridad</span>
                            </div>
                            <div class="h-1 w-full bg-surface-container rounded-full overflow-hidden flex gap-1">
                                <div class="h-full w-1/4 bg-amber-400 rounded-full"></div>
                                <div class="h-full w-1/4 bg-amber-400 rounded-full"></div>
                                <div class="h-full w-1/4 bg-surface-container-highest rounded-full"></div>
                                <div class="h-full w-1/4 bg-surface-container-highest rounded-full"></div>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-widest mb-3">Confirmar Nueva Contraseña</label>
                        <div class="relative group">
                            <input id="passConfirm" name="ConfirmarPassword" type="password" placeholder="Repita su nueva contraseña"
                                   class="w-full bg-surface-container-highest border-none px-6 py-4 rounded-lg focus:ring-1 focus:ring-primary/20 focus:bg-white transition-all text-primary"/>
                            <span onclick="togglePass('passConfirm', this)"
                                  class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 cursor-pointer z-10 select-none">visibility</span>
                        </div>
                    </div>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="p-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">@ViewBag.Error</div>
                }
                @if (ViewBag.Success != null)
                {
                    <div class="p-3 rounded-lg bg-green-50 border border-green-200 text-green-700 text-sm">@ViewBag.Success</div>
                }

                <div class="pt-6 flex items-center gap-6">
                    <button type="submit"
                            class="bg-[#2E86DE] text-white px-10 py-4 rounded-lg font-medium shadow-lg shadow-blue-500/20 hover:shadow-xl hover:-translate-y-[1px] active:translate-y-[1px] transition-all">
                        Guardar Cambios
                    </button>
                    <a asp-action="Perfil" class="text-secondary font-medium hover:text-primary transition-colors px-6 py-4 no-underline">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>

    <aside class="w-96 bg-[#002547] text-white p-10 flex flex-col relative overflow-hidden flex-shrink-0">
        <div class="absolute top-0 right-0 opacity-10 pointer-events-none">
            <div class="w-80 h-80 rounded-full border border-white/20 -mr-20 -mt-20"></div>
        </div>
        <div class="relative z-10 flex flex-col h-full">
            <div class="mb-12">
                <span class="material-symbols-outlined text-4xl text-on-primary-container mb-6 block" style="font-variation-settings: 'FILL' 1;">verified_user</span>
                <h4 class="font-headline text-3xl mb-4 leading-tight">Estándares de Seguridad</h4>
                <p class="text-on-primary-container text-sm leading-relaxed font-light">
                    Siga estas pautas para mantener su cuenta segura.
                </p>
            </div>
            <div class="space-y-8 flex-1">
                <div class="flex gap-4">
                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-xs font-headline italic">1</div>
                    <div>
                        <h5 class="text-sm font-semibold mb-1">Longitud mínima</h5>
                        <p class="text-xs text-slate-300 leading-relaxed">Mínimo 8 caracteres. Una mayor longitud ofrece mejor protección.</p>
                    </div>
                </div>
                <div class="flex gap-4">
                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-xs font-headline italic">2</div>
                    <div>
                        <h5 class="text-sm font-semibold mb-1">Variedad de caracteres</h5>
                        <p class="text-xs text-slate-300 leading-relaxed">Combine mayúsculas, números y símbolos especiales.</p>
                    </div>
                </div>
                <div class="flex gap-4">
                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-xs font-headline italic">3</div>
                    <div>
                        <h5 class="text-sm font-semibold mb-1">Exclusividad</h5>
                        <p class="text-xs text-slate-300 leading-relaxed">No utilice contraseñas empleadas en otros servicios.</p>
                    </div>
                </div>
            </div>
            <div class="mt-auto pt-10 border-t border-white/10">
                <div class="bg-white/5 p-6 rounded-xl backdrop-blur-sm border border-white/5">
                    <div class="flex items-center gap-3 mb-3">
                        <span class="material-symbols-outlined text-on-primary-container">info</span>
                        <span class="text-xs font-bold uppercase tracking-widest text-on-primary-container">Soporte</span>
                    </div>
                    <p class="text-xs text-slate-300 leading-relaxed">
                        Si tiene dificultades con su contraseña, contáctenos a través del soporte técnico.
                    </p>
                </div>
            </div>
        </div>
    </aside>
</section>

<script>
    function togglePass(inputId, icon) {
        const input = document.getElementById(inputId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.textContent = 'visibility_off';
        } else {
            input.type = 'password';
            icon.textContent = 'visibility';
        }
    }
</script>
