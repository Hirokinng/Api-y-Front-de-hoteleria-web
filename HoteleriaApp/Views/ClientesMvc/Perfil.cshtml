@{
    ViewData["Title"] = "Clientes";
}

<div class="pb-12 px-8 max-w-[1400px] mx-auto pt-8">

    <div class="flex items-center gap-3 mb-8">
        <a asp-action="Index" class="p-2 text-secondary hover:text-primary hover:bg-surface-container-low rounded-lg transition-all">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
        </a>
        <span class="text-secondary text-sm">Clientes</span>
        <span class="material-symbols-outlined text-sm text-outline">chevron_right</span>
        <span class="text-primary text-sm font-medium">Perfil del Cliente</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <div class="flex flex-col gap-6">
            <div class="bg-white rounded-xl border border-outline-variant/20 shadow-sm p-8 text-center">
                <div class="w-24 h-24 rounded-full bg-surface-container-high border-2 border-on-primary-container mx-auto mb-4 flex items-center justify-center">
                    <span class="material-symbols-outlined text-4xl text-secondary">person</span>
                </div>
                <h3 class="font-headline text-2xl text-primary mb-1">@ViewBag.NombreCliente</h3>
                <p class="text-[#2E86DE] text-xs font-bold uppercase tracking-widest mb-4">Cliente Registrado</p>
                <span class="inline-flex items-center gap-2 bg-green-100 text-green-700 text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wide">
                    <span class="w-2 h-2 rounded-full bg-green-500"></span> Activo
                </span>
            </div>

            <div class="bg-[#002547] text-white rounded-xl p-6 shadow-sm">
                <h4 class="font-headline text-lg mb-4">Resumen de Cuenta</h4>
                <div class="space-y-4 border-t border-white/10 pt-4">
                    <div class="flex justify-between items-center">
                        <span class="text-white/50 text-xs uppercase tracking-widest">Reservas</span>
                        <span class="font-headline text-2xl text-on-primary-container">@(ViewBag.TotalReservas ?? 0)</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-white/50 text-xs uppercase tracking-widest">Miembro desde</span>
                        <span class="text-sm font-medium">@(ViewBag.FechaRegistro ?? "—")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="lg:col-span-2 flex flex-col gap-6">
            <div class="bg-white rounded-xl border border-outline-variant/20 shadow-sm p-8">
                <div class="flex items-center justify-between mb-6">
                    <h1 class="font-headline text-3xl text-primary">Detalles del Cliente</h1>
                    <div class="flex gap-3">
                        <a asp-action="ActualizarPerfil"
                           class="px-5 py-2.5 border-2 border-outline-variant text-secondary font-bold text-sm rounded-lg hover:bg-surface-container-low transition-all no-underline">
                            Actualizar Perfil
                        </a>
                        <a asp-action="CambiarPassword"
                           class="px-5 py-2.5 bg-[#2E86DE] text-white font-bold text-sm rounded-lg hover:bg-[#2575c0] transition-all no-underline shadow-lg shadow-blue-500/20">
                            Cambiar Contraseña
                        </a>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-widest text-secondary mb-1">Nombre Completo</p>
                        <p class="text-on-surface font-medium text-lg">@ViewBag.NombreCliente</p>
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-widest text-secondary mb-1">
                            <span class="material-symbols-outlined text-xs align-middle">mail</span> Email
                        </p>
                        <p class="text-on-surface font-medium text-lg">@ViewBag.EmailCliente</p>
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-widest text-secondary mb-1">
                            <span class="material-symbols-outlined text-xs align-middle">phone</span> Teléfono
                        </p>
                        <p class="text-on-surface font-medium text-lg">@(ViewBag.TelefonoCliente ?? "—")</p>
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-widest text-secondary mb-1">
                            <span class="material-symbols-outlined text-xs align-middle">calendar_today</span> Fecha de Registro
                        </p>
                        <p class="text-on-surface font-medium text-lg">@(ViewBag.FechaRegistro ?? "—")</p>
                    </div>
                </div>

                <div class="mt-6 p-4 rounded-lg bg-blue-50 border border-blue-200 flex gap-3">
                    <span class="material-symbols-outlined text-[#2E86DE] flex-shrink-0">info</span>
                    <p class="text-sm text-secondary leading-relaxed">
                        Para modificar sus datos o cambiar su contraseña, utilice los botones de acción en la parte superior.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
