@{
    ViewData["Title"] = "Registro de Clientes";
    Layout = "_LayoutCliente";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Registro - HOTELERIA</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Newsreader:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#002547", "secondary": "#455f87",
                        "surface": "#f6f9fe", "background": "#f6f9fe",
                        "surface-container-highest": "#dfe3e8",
                        "surface-container-lowest": "#ffffff",
                        "on-surface": "#181c20", "on-surface-variant": "#43474e",
                        "outline": "#74777f", "outline-variant": "#c4c6cf",
                        "on-primary-container": "#59a6ff", "primary-fixed": "#d3e4ff",
                        "primary-container": "#003a6b",
                    },
                    fontFamily: { "headline": ["Newsreader", "serif"], "body": ["Inter", "sans-serif"] },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24; }
    </style>
</head>
<body class="bg-background font-body text-on-surface min-h-screen flex flex-col">
<main class="flex-grow flex flex-col md:flex-row">

    <section class="flex-grow flex items-center justify-center p-8 md:p-16">
        <div class="max-w-xl w-full">
            <header class="mb-12">
                <div class="mb-6">
                    <a asp-controller="ClientesMvc" asp-action="Login" class="text-primary font-headline italic text-2xl no-underline">HOTELERIA</a>
                </div>
                <h1 class="font-headline text-5xl font-semibold text-primary mb-4 leading-tight">Registro de Clientes</h1>
                <p class="text-secondary text-lg font-light">Cree una nueva cuenta para gestionar sus reservas y estancias.</p>
            </header>

            <form asp-controller="ClientesMvc" asp-action="Register" method="post" class="space-y-8">
                @Html.AntiForgeryToken()
                <div class="space-y-6">
                    <div>
                        <label class="block text-xs font-medium text-secondary uppercase tracking-widest mb-2 px-1">Nombre Completo</label>
                        <input name="Nombre" type="text" placeholder="Ej. Juan García"
                               class="w-full px-4 py-4 bg-surface-container-highest border-none rounded-lg focus:ring-2 focus:ring-primary/20 transition-all placeholder:text-outline/60"/>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-medium text-secondary uppercase tracking-widest mb-2 px-1">Email</label>
                            <input name="Email" type="email" placeholder="nombre@ejemplo.com"
                                   class="w-full px-4 py-4 bg-surface-container-highest border-none rounded-lg focus:ring-2 focus:ring-primary/20 transition-all placeholder:text-outline/60"/>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-secondary uppercase tracking-widest mb-2 px-1">Teléfono</label>
                            <input name="Telefono" type="tel" placeholder="+1 000 000 0000"
                                   class="w-full px-4 py-4 bg-surface-container-highest border-none rounded-lg focus:ring-2 focus:ring-primary/20 transition-all placeholder:text-outline/60"/>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-medium text-secondary uppercase tracking-widest mb-2 px-1">Contraseña</label>
                            <input name="Password" type="password" placeholder="••••••••"
                                   class="w-full px-4 py-4 bg-surface-container-highest border-none rounded-lg focus:ring-2 focus:ring-primary/20 transition-all placeholder:text-outline/60"/>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-secondary uppercase tracking-widest mb-2 px-1">Confirmar Contraseña</label>
                            <input name="ConfirmPassword" type="password" placeholder="••••••••"
                                   class="w-full px-4 py-4 bg-surface-container-highest border-none rounded-lg focus:ring-2 focus:ring-primary/20 transition-all placeholder:text-outline/60"/>
                        </div>
                    </div>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="p-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">@ViewBag.Error</div>
                }

                <div class="pt-4">
                    <button type="submit"
                            class="w-full md:w-auto px-10 py-4 bg-[#2E86DE] text-white font-medium rounded-lg shadow-lg shadow-blue-500/20 hover:bg-[#2575c4] active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                        <span>Completar Registro</span>
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </button>
                </div>
            </form>

            <footer class="mt-12 text-sm text-outline">
                <p>¿Ya tienes cuenta?
                    <a asp-controller="Clientes" asp-action="Login" class="text-primary underline underline-offset-4 decoration-primary/20 hover:decoration-primary">
                        Inicia sesión
                    </a>
                </p>
            </footer>
        </div>
    </section>

    <aside class="w-full md:w-[400px] lg:w-[480px] bg-primary text-white p-12 flex flex-col justify-center relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -mr-32 -mt-32 blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-96 h-96 bg-primary-container/30 rounded-full -ml-48 -mb-48 blur-3xl"></div>
        <div class="relative z-10">
            <div class="mb-10 inline-flex items-center justify-center w-16 h-16 rounded-full bg-white/10 backdrop-blur-md">
                <span class="material-symbols-outlined text-3xl text-on-primary-container">verified_user</span>
            </div>
            <h2 class="font-headline text-4xl mb-8">Consejos de Seguridad</h2>
            <div class="space-y-10">
                <div class="flex gap-6">
                    <span class="material-symbols-outlined text-on-primary-container flex-shrink-0 mt-1">password</span>
                    <div>
                        <h3 class="font-medium text-lg mb-2">Contraseñas Robustas</h3>
                        <p class="text-slate-300 font-light leading-relaxed">Utilice una combinación de letras, números y símbolos. Evite usar fechas de nacimiento o nombres comunes.</p>
                    </div>
                </div>
                <div class="flex gap-6">
                    <span class="material-symbols-outlined text-on-primary-container flex-shrink-0 mt-1">phonelink_lock</span>
                    <div>
                        <h3 class="font-medium text-lg mb-2">Verificación en Dos Pasos</h3>
                        <p class="text-slate-300 font-light leading-relaxed">Le recomendamos activar la autenticación multifactor desde su panel de configuración.</p>
                    </div>
                </div>
                <div class="flex gap-6">
                    <span class="material-symbols-outlined text-on-primary-container flex-shrink-0 mt-1">privacy_tip</span>
                    <div>
                        <h3 class="font-medium text-lg mb-2">Privacidad de Datos</h3>
                        <p class="text-slate-300 font-light leading-relaxed">Sus datos están protegidos. Nunca compartiremos su información con terceros sin su consentimiento.</p>
                    </div>
                </div>
            </div>
            <div class="mt-16 p-6 rounded-xl bg-white/5 border border-white/10 backdrop-blur-sm">
                <p class="text-sm italic text-slate-400">"La excelencia en el servicio comienza con la confianza que deposita en nosotros."</p>
                <p class="mt-4 text-xs font-semibold uppercase tracking-tighter text-on-primary-container">— Concierge Digital</p>
            </div>
        </div>
    </aside>
</main>
</body>
</html>
